; Converts between Zinnia values and JSON text.
;
; Example:
; ```
; text = json.jsonify({'name': 'Zinnia', 'tags': ['fast', 'fun']})
; ; {"name":"Zinnia","tags":["fast","fun"]}
; json.parse(text)['tags'][1]   ; 'fun'
; ```

import error
import struct

; Returns [value] as JSON text. Strings, Arrays and Tuples, and Maps become
; JSON strings, arrays and objects; other objects become objects of their
; fields. None, Bools and numbers become null, true and false, and numbers.
function jsonify(value) {
  if value == None {
    return i'null'
  } else if is_bool(value) {
    return if value then i'true' else i'false'
  } else if value is Object {
    return _jsonify_object(value)
  }
  return str(value)
}

function _jsonify_string(s) {
  out = '"'
  for i=0, i < s.len(), i=i+1 {
    c = str(s[i])
    if c == '"' {
      out.extend('\\"')
    } else if c == '\\' {
      out.extend('\\\\')
    } else if c == '\n' {
      out.extend('\\n')
    } else if c == '\r' {
      out.extend('\\r')
    } else if c == '\t' {
      out.extend('\\t')
    } else {
      out.extend(c)
    }
  }
  return out.extend('"')
}

function _jsonify_object(obj) {
  if is_string(obj) {
    return _jsonify_string(obj)
  } else if (obj is Array) or (obj is Tuple) {
    return _jsonify_array(obj)
  } else if obj is struct.Map {
    return _jsonify_map(obj)
  }
  entries = []
  for (_, f) in obj.class().fields() {
    entries.append(_jsonify_string(str(f)) + ':' + jsonify(obj.$get(f)))
  }
  return '{' + ','.join(entries) + '}'
}

function _jsonify_array(arr) {
  entries = []
  for (_, e) in arr {
    entries.append(jsonify(e))
  }
  return '[' + ','.join(entries) + ']'
}

function _jsonify_map(map) {
  entries = []
  for (k, v) in map {
    entries.append(_jsonify_string(str(k)) + ':' + jsonify(v))
  }
  return '{' + ','.join(entries) + '}'
}

; Returns the value of [text], a JSON document. Objects become Maps, arrays
; Arrays, strings Strings, and true, false and null become True, False and
; None. A number becomes a Float if it has a fraction or an exponent, and an
; Int otherwise. Raises a ParseError if [text] isn't JSON.
;
; Example: `json.parse('{"a": [1, 2.5, null]}')['a']` is `[1, 2.5, None]`.
function parse(text) {
  return _Parser(text).parse()
}

; Raised by parse() for text that isn't JSON. [line] and [column], counted
; from 1, are where the problem is.
class ParseError : error.Error {
  new(message, field line, field column) {
    super(error.Error)(cat(message, ' (line ', line, ', column ', column, ')'))
  }
}

; Characters, for comparing with those of a string: text[i] is a character,
; which isn't equal to any String.
self._QUOTE = '"'[0]
self._BACKSLASH = '\\'[0]
self._LBRACE = '{'[0]
self._RBRACE = '}'[0]
self._LBRACKET = '['[0]
self._RBRACKET = ']'[0]
self._COMMA = ','[0]
self._COLON = ':'[0]
self._MINUS = '-'[0]
self._PLUS = '+'[0]
self._PERIOD = '.'[0]
self._ZERO = '0'[0]
self._LOWER_E = 'e'[0]
self._UPPER_E = 'E'[0]
self._SPACE = ' '[0]
self._TAB = '\t'[0]
self._NEWLINE = '\n'[0]
self._RETURN = '\r'[0]

; Parses JSON text, from the start.
class _Parser {
  field pos, size, next_backslash

  new(field text) {
    pos = 0
    size = text.len()
    next_backslash = -1
  }

  method parse() {
    value = _value()
    _skip_space()
    if pos < size {
      _fail(cat('Unexpected ', _describe(), ' after the value'))
    }
    return value
  }

  method _value() {
    _skip_space()
    if pos >= size {
      _fail('Expected a value but the text ended')
    }
    c = text[pos]
    if c == _QUOTE {
      return _string()
    } else if c == _LBRACE {
      return _object()
    } else if c == _LBRACKET {
      return _array()
    } else if (c == _MINUS) or _is_digit(c) {
      return _number()
    } else if _take_word('true') {
      return True
    } else if _take_word('false') {
      return False
    } else if _take_word('null') {
      return None
    }
    _fail(cat('Unexpected ', _describe()))
  }

  method _object() {
    pos = pos + 1
    map = {}
    _skip_space()
    if _take(_RBRACE) {
      return map
    }
    while True {
      _skip_space()
      if (pos >= size) or (text[pos] != _QUOTE) {
        _fail(cat('Expected a string key but found ', _describe()))
      }
      key = _string()
      _skip_space()
      _expect(_COLON, '\':\'')
      map[key] = _value()
      _skip_space()
      if _take(_RBRACE) {
        return map
      }
      _expect(_COMMA, '\',\' or \'}\'')
    }
  }

  method _array() {
    pos = pos + 1
    arr = []
    _skip_space()
    if _take(_RBRACKET) {
      return arr
    }
    while True {
      arr.append(_value())
      _skip_space()
      if _take(_RBRACKET) {
        return arr
      }
      _expect(_COMMA, '\',\' or \']\'')
    }
  }

  method _string() {
    start = pos
    pos = pos + 1
    out = ''
    while True {
      quote = text.find('"', pos)
      if quote == None {
        _fail('The string doesn\'t end', start)
      }
      backslash = _next_backslash()
      if quote < backslash {
        out.extend(text.substr(pos, quote - pos))
        pos = quote + 1
        return out
      }
      out.extend(text.substr(pos, backslash - pos))
      pos = backslash + 1
      _escape(out)
    }
  }

  ; Returns the index of the first backslash at or after pos, or size if there
  ; is none. It's remembered, so the text after it is searched only once.
  method _next_backslash() {
    if next_backslash < pos {
      found = text.find('\\', pos)
      next_backslash = if found == None then size else found
    }
    return next_backslash
  }

  ; Adds the character that the escape sequence at pos, after its backslash,
  ; stands for to [out].
  method _escape(out) {
    if pos >= size {
      _fail('The string doesn\'t end')
    }
    c = str(text[pos])
    pos = pos + 1
    if (c == '"') or (c == '\\') or (c == '/') {
      out.extend(c)
    } else if c == 'n' {
      out.extend('\n')
    } else if c == 't' {
      out.extend('\t')
    } else if c == 'r' {
      out.extend('\r')
    } else if c == 'b' {
      out.extend(str(__char(8)))
    } else if c == 'f' {
      out.extend(str(__char(12)))
    } else if c == 'u' {
      _unicode_escape(out)
    } else {
      _fail(cat('Unknown escape sequence \'\\', c, '\''), pos - 2)
    }
  }

  ; Adds the character of the \u escape at pos, after its 'u', to [out] as
  ; UTF-8. A character outside the Basic Multilingual Plane is written as two
  ; escapes, a high and a low surrogate.
  method _unicode_escape(out) {
    start = pos - 2
    code = _hex4()
    if (code >= 56320) and (code < 57344) {
      _fail('Unpaired low surrogate', start)
    }
    if (code >= 55296) and (code < 56320) {
      if ~_take_word('\\u') {
        _fail('Expected a low surrogate after a high one', start)
      }
      low = _hex4()
      if (low < 56320) or (low >= 57344) {
        _fail('Expected a low surrogate after a high one', start)
      }
      code = 65536 + (code - 55296) * 1024 + (low - 56320)
    }
    _append_utf8(out, code)
  }

  ; Reads the four hexadecimal digits at pos.
  method _hex4() {
    if pos + 4 > size {
      _fail('Expected four hexadecimal digits')
    }
    code = 0
    for i = 0, i < 4, i = i + 1 {
      d = _hex_digit(Int(text[pos + i]))
      if d == None {
        _fail('Expected four hexadecimal digits', pos)
      }
      code = code * 16 + d
    }
    pos = pos + 4
    return code
  }

  method _number() {
    start = pos
    _take(_MINUS)
    if ~_take(_ZERO) and (_digits() == 0) {
      _fail('Expected a digit')
    }
    is_float = False
    if _take(_PERIOD) {
      if _digits() == 0 {
        _fail('Expected a digit after \'.\'')
      }
      is_float = True
    }
    if _take(_LOWER_E) or _take(_UPPER_E) {
      if ~_take(_PLUS) {
        _take(_MINUS)
      }
      if _digits() == 0 {
        _fail('Expected a digit in the exponent')
      }
      is_float = True
    }
    number = text.substr(start, pos - start)
    return if is_float then Float(number) else Int(number)
  }

  ; Skips the digits at pos, and returns how many there were.
  method _digits() {
    start = pos
    while (pos < size) and _is_digit(text[pos]) {
      pos = pos + 1
    }
    return pos - start
  }

  method _skip_space() {
    while pos < size {
      c = text[pos]
      if (c != _SPACE) and (c != _NEWLINE) and (c != _RETURN) and (c != _TAB) {
        return
      }
      pos = pos + 1
    }
  }

  ; Skips the character [c] if it's at pos, and returns whether it was.
  method _take(c) {
    if (pos < size) and (text[pos] == c) {
      pos = pos + 1
      return True
    }
    return False
  }

  ; Skips [word] if it's at pos, and returns whether it was.
  method _take_word(word) {
    n = word.len()
    if (pos + n <= size) and (text.substr(pos, n) == word) {
      pos = pos + n
      return True
    }
    return False
  }

  method _expect(c, description) {
    if ~_take(c) {
      _fail(cat('Expected ', description, ' but found ', _describe()))
    }
  }

  ; Describes the character at pos, for an error.
  method _describe() {
    if pos >= size {
      return 'the end of the text'
    }
    return cat('\'', text[pos], '\'')
  }

  ; Raises a ParseError with [message] at index [at] of the text.
  method _fail(message, at=None) {
    if at == None {
      at = pos
    }
    line = 1
    line_start = 0
    newline = text.find('\n')
    while (newline != None) and (newline < at) {
      line = line + 1
      line_start = newline + 1
      newline = text.find('\n', line_start)
    }
    raise ParseError(message, line, at - line_start + 1)
  }
}

function _is_digit(c) {
  code = Int(c)
  return (code >= 48) and (code <= 57)
}

; The value of the hexadecimal digit whose character code is [code], or None.
function _hex_digit(code) {
  if (code >= 48) and (code <= 57) {
    return code - 48
  } else if (code >= 97) and (code <= 102) {
    return code - 87
  } else if (code >= 65) and (code <= 70) {
    return code - 55
  }
  return None
}

; Adds the code point [code] to [out] in UTF-8.
function _append_utf8(out, code) {
  if code < 128 {
    out.extend(str(__char(code)))
  } else if code < 2048 {
    out.extend(str(__char(192 + code / 64)))
        .extend(str(__char(128 + code % 64)))
  } else if code < 65536 {
    out.extend(str(__char(224 + code / 4096)))
        .extend(str(__char(128 + (code / 64) % 64)))
        .extend(str(__char(128 + code % 64)))
  } else {
    out.extend(str(__char(240 + code / 262144)))
        .extend(str(__char(128 + (code / 4096) % 64)))
        .extend(str(__char(128 + (code / 64) % 64)))
        .extend(str(__char(128 + code % 64)))
  }
}
