; Unit tests.
;
; A test file annotates classes with TestClass and their test methods with
; Test, and runs them with Tester:
; ```
; import test
;
; test.Tester().test(self)
;
; @test.TestClass
; class MathTest {
;   @test.Test
;   method test_add() {
;     test.expect(1 + 1, 2)
;   }
; }
; ```
; Running the file runs its tests, and fails if any fails. To run only some,
; list them with --test, e.g. `zinnia math_test.zn -- --test=MathTest.test_add`.

import error
import io

; Marks a class whose Test methods are tests.
class TestClass {
  ; Called with the annotated class; does nothing.
  method annotate(cls) {}
}

; Marks a method of a TestClass as a test.
class Test {
  ; Called with the annotated method; does nothing.
  method annotate(cls) {}
}

; Marks a method of a TestClass to run before each of its tests.
class SetUp {
  ; Called with the annotated method; does nothing.
  method annotate(cls) {}
}

; Marks a method of a TestClass to run after each of its tests.
class TearDown {
  ; Called with the annotated method; does nothing.
  method annotate(cls) {}
}

; The error a failed expectation raises.
class ExpectError : error.Error {
  ; Creates the error with the message [str].
  new(str) {
    super(error.Error)(str)
  }
}

; Raises an ExpectError unless [actual] == [expected].
function expect(actual, expected) {
  try {
    if actual == expected {
      return
    }
  } catch e {}
  raise ExpectError('Expected \'' + str(expected) + '\' but was \'' + str(actual) + '\'.')
}

; Raises an ExpectError unless [actual] != [not_expected].
function expect_not(actual, not_expected) {
  try {
    if actual != not_expected {
      return
    }
  } catch e {}
  raise ExpectError('Expected not \'' + str(not_expected) + '\' but was \'' + str(actual) + '\'.')
}

; Calls [exp] and raises an ExpectError unless it raises an error, of class
; [error_class] if given.
function expect_raises(exp, error_class=None) {
  try {
    exp()
  } catch e {
    if ~e or ~error_class or (e is error_class) {
      return
    }
    raise ExpectError('Raises wrong error')
  }
  raise ExpectError('Does not raise')
}

; Raises an ExpectError unless [actual] is an instance of [expected_class].
function expect_is(actual, expected_class) {
  try {
    if actual is expected_class {
      return
    }
  } catch e {}
  raise ExpectError('Expected of type \'' + str(expected_class) + '\' but was \'' + str(actual.class()) + '\'.')
}

; 'PASS', in green.
self.PASS = color('32;1').extend('PASS').extend(color(0))
; 'FAIL', in red.
self.FAIL = color('31;1').extend('FAIL').extend(color(0))

; Runs a module's tests.
class Tester {
  ; Runs the tests of [module], usually `self`: each Test method of each
  ; TestClass, on a new instance, between its SetUp and TearDown methods. Prints
  ; the failures and how many passed, and raises an error if any failed or none
  ; were found. The --test flag limits the tests run (see _is_selected()).
  method test(module) {
    stats = []
    for (_, cls) in module.classes() {
      if ~_is_test_class(cls) {
        continue
      }
      setups = _extract_methods(cls, SetUp)
      teardowns =  _extract_methods(cls, TearDown)
      for (_, meth) in cls.all_methods() {
        if ~_method_is_test(meth) {
          continue
        }
        if ~_is_selected(cls, meth) {
          continue
        }
        pass = True
        err = None
        try {
          instance = cls()
          setups.each(setup -> instance.$get(setup.name())())
          instance.$get(meth.name())()      
          teardowns.each(teardown -> instance.$get(teardown.name())())
        } catch e {
          pass = False
          err = e
        }
        stats.append(cls, meth, pass, err)
      }
    }
    failures = stats.where((_, _, pass, _) -> ~pass)
    num_passes = stats.count((_, _, pass, _) -> pass)
    col = if num_passes == stats.len() then '32;1' else '31;1'
    for (_, (cls, meth, _, err)) in failures {
      io.println('Test ' + cls.name() + '.' + meth.name() + '=' + FAIL + '\n')
      io.println(err)
    }
    io.println(
      'Tests [' + color(col) + str(num_passes) + '/' + str(stats.len()) + color(0) + '] passed.')
    if stats.len() == 0 {
      raise error.Error('No tests found.')
    }
    if num_passes != stats.len() {
      raise error.Error(str(stats.len() - num_passes) + ' test(s) failed.')
    }
  }

  ; Whether [meth] of [cls] is one of the tests to run. The --test flag, if
  ; given, lists them, separated by commas, as class names, method names or
  ; Class.method names, e.g. --test=MathTest.test_abs,StringTest.
  method _is_selected(cls, meth) {
    if ~args or ~args.test {
      return True
    }
    class_name = str(cls.name())
    method_name = str(meth.name())
    for (_, name) in str(args.test).split(',') {
      name = name.trim()
      if (name == class_name) or (name == method_name) or (name == cat(class_name, '.', method_name)) {
        return True
      }
    }
    return False
  }

  ; Returns whether [cls] is annotated with TestClass.
  method _is_test_class(cls) {
    for (_, annot) in cls.all_annotations() {
      if annot is TestClass {
        return True
      }
    }
    return False
  }

  ; Returns whether the method [func] is annotated with Test.
  method _method_is_test(func) {
    for (_, annot) in func.annotations {
      if annot is Test {
        return True
      }
    }
    return False
  }

  ; Returns the methods of [test_cls] annotated with the annotation class [cls].
  method _extract_methods(test_cls, cls) {
    methods = []
    for (_, meth) in test_cls.all_methods() {
      for (_, annot) in meth.annotations {
        if annot is cls {
          methods.append(meth)
        }
      }
    }
    return methods
  }
}
