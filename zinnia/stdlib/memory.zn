; Garbage collection and memory use.

_ = None
; The result of a garbage collection.
class GCStatus {
  ; Creates a status: [objects_collected] objects were freed,
  ; [remaining_object_count] remain, and [object_counts] has a (class, count)
  ; pair for each class of remaining objects.
  new(field objects_collected,
      field remaining_object_count,
      field object_counts) {
  }

  ; Returns the counts, with the most common classes first.
  method to_s() {
    sort(object_counts, (oc1, oc2) {
      ; Most common classes first, then alphabetically.
      if oc1[1] == oc2[1] {
        return cmp(oc1[0].name(), oc2[0].name())
      }
      return oc2[1] - oc1[1]
    })
    result = cat(
        'Objects collected: ',
        objects_collected,
        '\nRemaining objects: ',
        remaining_object_count,
        '\n')
    if object_counts {
      for (_, (cls, count)) in object_counts {
        result.extend(cat('  ', count, ' x ', cls.name(), '\n'))
      }
    }
    return result
  }
}

; Collects garbage now, and returns a future to its GCStatus.
function collect_garbage() async {
  GCStatus(await __collect_garbage())
}