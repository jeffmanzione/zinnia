; HTTP: requests and responses, sockets that speak HTTP, and a framework for
; serving applications from annotated controller classes, whose dependencies
; are injected (see inject).
;
; Example:
; ```
; @inject.Inject(keys: [net.HttpRequest])
; class IndexMatcher : net.RequestMatcher {
;   new(field http_request) {}
;   method matches() ~~http_request and (http_request.path == '/')
; }
;
; @net.HttpRequestController(IndexMatcher)
; @inject.Inject(keys: [net.HttpResponse])
; class IndexController {
;   new(field http_response) {}
;   @net.Get
;   method get() {
;     http_response.add_content('<h1>Hello</h1>')
;   }
; }
;
; net.Server()
;     .add_application(
;         net.Application('localhost', 8080).add_controller(IndexController))
;     .run()
; ```

import async
import error
import inject
import io
import net
import socket
import struct

; An HTTP request.
class HttpRequest {
  field _headers
  ; Creates a request: its method [type] (e.g. 'GET'), [path], query [params] (a
  ; Map), [protocol] (e.g. 'HTTP'), [version] and [headers] (a Map).
  new(field type,
      field path,
      field params,
      field protocol,
      field version,
      headers) {
    _headers = headers
  }
  ; Returns the value of the header [key], or None.
  method get_header_value(key) {
    return _headers[key]
  }
  ; Returns the Host header.
  method get_host() {
    return _headers[i'Host']
  }
  ; Returns the Connection header.
  method get_connection() {
    return _headers[i'Connection']
  }
  ; Returns the User-Agent header.
  method get_user_agent() {
    return _headers[i'User-Agent']
  }
  ; Returns the Accept header's media types, as an Array.
  method get_accept() {
    return _headers[i'Accept'].split(',')
  }
  ; Returns the Cookie header.
  method get_cookie() {
    return _headers[i'Cookie']
  }
  ; Returns the request line and headers.
  method to_s() {
    ret = cat(type, ' ', path)
    if params and (params.keys.len() > 0) {
      ret.extend('?')
      param_arr = []
      for (k, v) in params {
        param_arr.append(cat(k, '=', v))
      }
      ret.extend('&'.join(param_arr))
    }
    ret.extend(' ').extend(protocol).extend('/')
        .extend(version).extend('\r\n')
    if _headers {
      for (k, v) in _headers {
        ret.extend('  ').extend(k).extend(': ').extend(str(v))
            .extend('\r\n')
      }
    }
    return ret
  }
}


; An HTTP response. Its setters return the response, so calls can be chained:
; `HttpResponse().set_content_type('text/plain').add_content('Hi')`.
class HttpResponse {
  field _protocol, _version, _status_code, _status
  field _headers, _content, _set_cookies
  ; Creates a '200 OK' HTTP/1.1 text/html response with no content.
  new() {
    _protocol = i'HTTP'
    _version = 1.1
    _status_code = 200
    _status = i'OK'
    _headers = {}
    _headers[i'Content-Type'] = i'text/html'
    _headers[i'Accept-Ranges'] = i'bytes'
    _headers[i'Content-Length'] = 0
    _content = ''
    _set_cookies = {}
  }
  ; Sets the status text, e.g. 'NOT FOUND'.
  method set_status(status) {
    _status = status
    return self
  }
  ; Sets the status code, e.g. 404.
  method set_status_code(status_code) {
    _status_code = status_code
    return self
  }
  ; Sets the Server header.
  method set_server(server) {
    _headers[i'Server'] = server
    return self
  }
  ; Sets the Date header.
  method set_date(date_text) {
    _headers[i'Date'] = date_text
    return self
  }
  ; Sets the Last-Modified header.
  method set_last_modified(date_text) {
    _headers[i'Last-Modified'] = date_text
    return self
  }
  ; Sets the Content-Type header, e.g. 'application/json'.
  method set_content_type(type) {
    _headers[i'Content-Type'] = type
    return self
  }
  ; Sets the Accept-Ranges header.
  method set_accept_ranges(ranges) {
    _headers[i'Accept-Ranges'] = ranges
    return self
  }
  ; Sets the cookie [name] to [value] with a Set-Cookie header. Unlike the other setters, returns None.
  method set_cookie(name, value) {
    _set_cookies[str(name)] = str(value)
  }
  ; Appends [text] to the body, updating Content-Length.
  method add_content(text) {
    _content.extend(text)
    _headers[i'Content-Length'] = _headers[i'Content-Length'] + text.len()
    return self
  }
  ; Returns the response as sent: the status line, headers and body.
  method to_s() {
    res = cat(_protocol, '/', _version, ' ', _status_code, ' ', _status, '\r\n')
    for (k, v) in _headers {
      res.extend(cat(k, ': ', v, '\r\n'))
    }
    for (name, value) in _set_cookies {
      res.extend((cat('Set-Cookie: ', _set_cookie_string(name, value), '\r\n')))
    }
    res.extend('\r\n')
    res.extend(_content)
    return res
  }
  ; Returns the Set-Cookie value for [name] and [value].
  method _set_cookie_string(name, value) {
    return cat(name, '="', value, '"')
  }
}

; Makes [response] a 301 redirect to [target], keeping [request]'s query
; parameters, and returns it.
function redirect(request, response, target) {
  response.set_status_code(301)
  location = target
  if request.params and (request.params.keys.len() > 0) {
    location.extend('?')
    param_arr = []
    for (k, v) in request.params {
      param_arr.append(cat(k, '=', v))
    }
    location.extend('&'.join(param_arr))
  }
  response._headers[i'Location'] = location
  return response
}

; Splits [path] at '?' and returns (path, params), with the query's
; parameters in a Map; a parameter without '=' has the value '1'.
function parse_params(path) {
  q_index = path.find('?')
  if ~q_index {
    return (path, {})
  }
  (
    path.substr(0, q_index),
    path.substr(q_index + 1)
      .split('&')
      .collect(
        (a, part) {
          eq_index = part.find('=')
          if ~eq_index {
            a[part] = '1'
          } else {
            a[part.substr(0, eq_index)] = part.substr(eq_index + 1)
          }
          return a
        },
        {}))
}

; Returns the HttpRequest that the text [req] holds, or None if it's invalid, printing the error.
function parse_request(req) {
  try {
    parts = req.split('\r\n')
    if parts.len() == 0 {
      raise error.Error(cat('Invalid request: ', req))
    }
    request = parts[0].trim()
    req_head = request.split(' ')
    type = req_head[0]
    path = req_head[1]
    (path, params) = parse_params(path)
    protocol = req_head[2].split('/')

    map = {}
    for i=1, i<parts.len(), i=i+1 {
      ; Split at the first ':' since values may contain ':' (e.g. Host: a:80).
      line = parts[i]
      colon = line.find(':')
      if colon == None {
        continue
      }
      map[line.substr(0, colon).trim()] = line.substr(colon + 1).trim()
    }
    return HttpRequest(type, path, params, protocol[0], protocol[1], map)
  } catch e {
    io.fprintln(io.ERROR, e)
    return None
  }
}

; The cookies of the current request, injected into controllers. Setting one
; also sets it on the response.
@inject.Inject(keys: [HttpRequest, inject.Provider(HttpResponse)])
class Cookies {
  field cookies_map

  ; Creates the cookies of [req], setting new ones on the response [resp_provider] provides.
  new(field req, field resp_provider) {
    cookies_map = _parse_cookie_map(req.get_cookie())
  }
  ; Returns the value of the cookie [name], or None.
  method [](name) {
    return cookies_map[name]
  }
  ; Sets the cookie [name] to [value], on the response too.
  method []=(name, value) {
    cookies_map[name] = value
    resp_provider().set_cookie(name, value)
  }
  ; Returns the cookies as a Map's text.
  method to_s() {
    return cookies_map.to_s()
  }
  ; Returns the cookies of a Cookie header, as a Map.
  method _parse_cookie_map(cookie_string) {
    if ~cookie_string or cookie_string == '' {
      return {}
    }

    res = {}
    kvs = cookie_string.split('; ')
    for i=0, i<kvs.len(), i=i+1 {
      kv = kvs[i].split('=')
      res[kv[0]] = kv[1]
    }
    return res
  }
}

; A connection that receives HttpRequests and sends HttpResponses.
class HttpSocketHandle {
  ; Wraps the socket.SocketHandle [raw_handle].
  new(field raw_handle) {}

  ; Returns a future to the next request, or to None once the connection is closed.
  method receive() async {
    raw_request = await raw_handle.receive()
    ; When the connection is gracefully closed, the response is None.
    if ~raw_request {
      return None
    }
    return parse_request(raw_request)
  }
  ; Sends [http_response], an HttpResponse; raises an error for anything else.
  method send(http_response) async {
    if ~(http_response is HttpResponse) {
      raise error.Error(i'HttpSocketHandle.send() expects an HttpResponse argument.')
    }
    await raw_handle.send(http_response.to_s())
  }
  ; Closes the connection.
  method close() {
    raw_handle.close()
  }
}

; A server socket that accepts HTTP connections.
class HttpSocket {
  ; Wraps the server socket.Socket [raw_socket].
  new(field raw_socket) {}

  ; Returns a future to the next connection, as an HttpSocketHandle.
  method accept() async {
    HttpSocketHandle(await raw_socket.accept())
  }
  ; Closes the socket.
  method close() {
    raw_socket.close()
  }
}

; Marker for the raw request string.
class RawRequest {}
; Marker for the raw response string.
class RawResponse {}

; Provides the HttpRequest parsed from the RawRequest and the HttpResponse of
; the current request, and the RawResponse text of that response.
class BaseHttpProviderSet: inject.ProviderSet {
  field req, resp, http_resp

  ; Creates the provider set.
  new() {
    super(inject.ProviderSet)()
  }

  ; Returns the current request's HttpResponse, creating it the first time.
  @inject.Provides(key: HttpResponse)
  method base_response() {
    if ~http_resp {
      http_resp = HttpResponse()
    }
    return http_resp
  }

  ; Returns the HttpRequest parsed from [raw_req], parsing it the first time.
  @inject.Provides(key: HttpRequest, params: [RawRequest])
  method marshall(raw_req) {
    if ~raw_req {
      return None
    }
    if ~req {
      req = parse_request(raw_req)
      io.println('HTTP/' + req.version + ' ' + req.path)
      resp = None
      http_resp = None
    }
    return req
  }

  ; Returns the text of [http_resp], the response to send.
  @inject.Provides(key: RawResponse, params: [HttpResponse])
  method unmarshall(http_resp) {
    if ~http_resp {
      return None
    }
    if ~resp {
      resp = http_resp.to_s()
      req = None
    }
    return resp
  }
}

; Marks the method of a RequestController's controller that handles requests.
class Rpc { method annotate(_) {} }

; Marks the method of an HttpRequestController's controller that handles GET requests.
class Get { method annotate(_) {} }
; Marks the method that handles HEAD requests.
class Head { method annotate(_) {} }
; Marks the method that handles POST requests.
class Post { method annotate(_) {} }
; Marks the method that handles PUT requests.
class Put { method annotate(_) {} }
; Marks the method that handles DELETE requests.
class Delete { method annotate(_) {} }
; Marks the method that handles CONNECT requests.
class Connect { method annotate(_) {} }
; Marks the method that handles OPTIONS requests.
class Options { method annotate(_) {} }
; Marks the method that handles TRACE requests.
class Trace { method annotate(_) {} }
; Marks the method that handles PATCH requests.
class Patch { method annotate(_) {} }

; Returns True: matches every request.
function always_true() {
  True
}

; Annotates a controller class: requests that [matcher_fn] accepts go to its
; Rpc method, with the value injected for [request_key], and its response is
; the value injected for [response_key].
class RequestController {
  ; Creates the annotation. [matcher_fn] is a function of the raw request text,
  ; or a RequestMatcher class, which is constructed by the injector.
  new(field matcher_fn=always_true, field request_key = RawRequest, field response_key = RawResponse) {}
  ; Calls the Rpc method of [controller].
  method process(controller, req) {
    return find_annotated_method(controller, Rpc)()
  }
}

; Decides which requests a controller handles. Subclass it, inject what it
; needs (e.g. the HttpRequest) and override matches().
class RequestMatcher {
  ; Returns whether the controller handles the request; by default, False.
  method matches(raw_request) { False }
}

; Annotates a controller class that handles the HTTP requests that
; [http_matcher_fn] accepts with its Get, Post, etc. methods. They're called
; with the HttpRequest, and the response is the injected HttpResponse, so they
; usually add to that.
class HttpRequestController : RequestController {
  ; Creates the annotation.
  new(http_matcher_fn=always_true) {
    super(RequestController)(http_matcher_fn, HttpRequest, HttpResponse)
  }

  ; Calls the method of [controller] annotated for [req]'s HTTP method.
  method process(controller, req) {
    find_annotated_method(controller, _get_label(req))(req)
  }

  ; Returns the annotation class for [req]'s HTTP method.
  method _get_label(req) { _REQUEST_METHOD_TO_ANNOTATION[req.type] }
}

; A web application: controller classes and provider sets, served at a host and port.
class Application {
  field controller_classes, provider_sets

  ; Creates an application served at [host] and [port], with no controllers.
  new(field host, field port) {
    controller_classes = []
    provider_sets = []
  }

  ; Adds the controller class [ctrlr_cls], annotated with a RequestController, and returns this.
  method add_controller(ctrlr_cls) {
    controller_classes.append(ctrlr_cls)
    return self
  }

  ; Adds the inject.ProviderSet class [ps] and returns this.
  method add_provider_set(ps) {
    provider_sets.append(ps)
    return self
  }

  ; Returns an ApplicationRunner for the application, in an isolate of its own; call run() to serve it.
  method start() {
    return async.spawn_actor(
        ApplicationRunner,
        (host, port, controller_classes, provider_sets))
  }
}

; The annotation class for each HTTP method.
self._REQUEST_METHOD_TO_ANNOTATION = {
  i'GET': Get,
  i'HEAD': Head,
  i'POST': Post,
  i'PUT': Put,
  i'DELETE': Delete,
  i'CONNECT': Connect,
  i'OPTIONS': Options,
  i'TRACE': Trace,
  i'PATCH': Patch
}

; Returns the method of [instance] annotated with [annot], bound to it. Raises
; an error unless there's exactly one.
function find_annotated_method(instance, annot) {
  cls = instance.class()
  methods = cls.all_methods().where(m -> m.annotations.has(a -> a is annot))
  if methods.len() == 0 {
    raise error.Error(str(cls) + ' has no ' + str(annot) + ' annotated methods.')
  } else if methods.len() > 1 {
    raise error.Error(str(cls) + ' has multiple ' + str(annot) + ' annotated methods.')
  }
  return instance.$get(methods[0].name())
}

; Serves an Application, as an actor (see Application.start()).
@async.Actor
class ApplicationRunner {
  field injector
  ; Creates the runner, installing the provider sets and controllers in an injector.
  new(field host, field port, field controller_classes, field provider_sets=[]) {
    injector = inject.Injector()
    provider_sets.each(ps -> injector.install(ps()))
    for (_, ctrlr_cls) in controller_classes {
      injector.install(ctrlr_cls)
    }
  }

  ; Returns (RequestController, controller class) for the first controller that matches [request].
  method _select_controller(request) {
    for (_, ctrlr_cls) in controller_classes {
      req_ctrlr = _get_request_controller(ctrlr_cls)
      matcher_fn = req_ctrlr.matcher_fn
      if (matcher_fn is Class) and matcher_fn.is_subclass_of(RequestMatcher) {
        matcher_fn = injector.get(matcher_fn).matches
      }
      if matcher_fn(request) {
        return (req_ctrlr, ctrlr_cls)
      }
    }
    return (None, None)
  }

  ; Returns the response to [request] from the controller that matches it.
  method process(request) {
    injector.install(RawRequest, () -> request)
    (req_ctrlr, ctrlr_cls) = _select_controller(request)
    if ~req_ctrlr or ~ctrlr_cls {
      raise error.Error('No controller found for request: ' + str(request))
    }
    ctrlr = injector.get(ctrlr_cls)
    request2 = injector.get(req_ctrlr.request_key)
    process_resp = req_ctrlr.process(ctrlr, request2)
    resp = injector.get(RawResponse)
    ; RawResponse is not bound, so fall back.
    if ~(resp is String) {
      return process_resp
    }
    return resp
  }

  ; Returns the RequestController annotation of [ctrlr_cls]; raises an error unless there's exactly one.
  method _get_request_controller(ctrlr_cls) {
    req_ctrlrs = ctrlr_cls.all_annotations().where(a -> a is RequestController)
    if req_ctrlrs.len() == 0 {
      raise error.Error(str(ctrlr_cls) + ' has no RequestController annotation.')
    } else if req_ctrlrs.len() > 1 {
      raise error.Error(str(ctrlr_cls) + ' has multiple RequestController annotations.')
    }
    return req_ctrlrs[0]
  }

  ; Serves requests until the program ends, one connection at a time, printing errors.
  method run() {
    sock = socket.create_server_socket(host, port)
    io.println('Started app at ' + str(host) + ':' +  str(port))
    while True {
      handle = await sock.accept()
      try {
        req = await handle.receive()
        resp = process(req)
        await handle.send(resp)
      } catch e {
        io.fprintln(io.ERROR, e)
      }
      handle.close()
    }
  }
}

; Serves several Applications at once.
class Server {
  field apps

  ; Creates a server with no applications.
  new() {
    apps = []
  }

  ; Adds the Application [app] and returns this.
  method add_application(app) {
    apps.append(app)
    return self
  }

  ; Starts and runs every application, until the program ends.
  method run() {
    await async.all(
     apps.map(app -> app.start().run())
    )
    ; runners = apps.map(app -> app.start())
    ; runners.each(r -> r.run())
  }
}
