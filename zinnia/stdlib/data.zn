; Arrays and matrices of numbers, stored compactly rather than as objects.
;
; Example:
; ```
; a = data.zeros(Int, 3)  ; Int64Array([0, 0, 0])
; a[1] = 5
; m = data.zeros2(Float, 2, 2)
; m[0, 1] = 1.5
; ```

import io

; Returns a data array of [count] zeros: an Int64Array for Int, a Float64Array
; for Float and an Int8Array for Char. Any other [type] is a data array class,
; e.g. Int32Array, and is constructed with [count].
function zeros(type, count) {
  if type == Int {
    return Int64Array(count)
  } else if type == Float {
    return Float64Array(count)
  } else if type == Char {
    return Int8Array(count)
  } else {
    return type(count)
  }
}

; Returns a [dim1] x [dim2] data matrix of zeros: an Int64Matrix for Int, a
; Float64Matrix for Float and an Int8Matrix for Char. Any other [type] is a data
; matrix class, e.g. Int32Matrix, and is constructed with [dim1] and [dim2].
function zeros2(type, dim1, dim2) {
  if type == Int {
    return Int64Matrix(dim1, dim2)
  } else if type == Float {
    return Float64Matrix(dim1, dim2)
  } else if type == Char {
    return Int8Matrix(dim1, dim2)
  } else {
    return type(dim1, dim2)
  }
}

; An array of 8-bit integers.
class Int8Array : DataArray {
  ; Creates an array of [count] zeros.
  declare new(count)
}
; An array of 32-bit integers.
class Int32Array : DataArray {
  ; Creates an array of [count] zeros.
  declare new(count)
}
; An array of 64-bit integers.
class Int64Array : DataArray {
  ; Creates an array of [count] zeros.
  declare new(count)
}
; An array of 32-bit floats.
class Float32Array : DataArray {
  ; Creates an array of [count] zeros.
  declare new(count)
}
; An array of 64-bit floats.
class Float64Array : DataArray {
  ; Creates an array of [count] zeros.
  declare new(count)
}

; A matrix of 8-bit integers.
class Int8Matrix : DataMatrix {
  ; Creates a [rows] x [cols] matrix of zeros.
  declare new(rows, cols)
}
; A matrix of 32-bit integers.
class Int32Matrix : DataMatrix {
  ; Creates a [rows] x [cols] matrix of zeros.
  declare new(rows, cols)
}
; A matrix of 64-bit integers.
class Int64Matrix : DataMatrix {
  ; Creates a [rows] x [cols] matrix of zeros.
  declare new(rows, cols)
}
; A matrix of 32-bit floats.
class Float32Matrix : DataMatrix {
  ; Creates a [rows] x [cols] matrix of zeros.
  declare new(rows, cols)
}
; A matrix of 64-bit floats.
class Float64Matrix : DataMatrix {
  ; Creates a [rows] x [cols] matrix of zeros.
  declare new(rows, cols)
}

; The base class of data arrays.
class DataArray {
  ; Returns the element at index [i].
  declare method [](i)
  ; Sets the element at index [i] to [value].
  declare method []=(i, value)
  ; Returns how many elements the array has.
  declare method len()
  ; Returns the elements as an Array.
  declare method to_arr() returns Array
  ; Returns a copy of the array in reverse order.
  declare method reversed()
  ; Returns a sorted copy of the array.
  declare method sorted()

  ; Returns e.g. 'Int64Array([1, 2, 3])', eliding the middle of long arrays.
  method to_s() {
    res = class().name() + '(['
    l = len()
    if l == 0 {
      return res + '])'
    }
    if l < 8 {
      for i = 0, i < l-1, i=i+1 {
        res.extend(str(self[i]) + ', ')
      }
      res.extend(str(self[l-1]))
    } else {
      for i = 0, i < 5, i=i+1 {
        res.extend(str(self[i]) + ', ')
      }
      res.extend('...' + str(self[l-1]))
    }
    return res + '])'
  }
}

; The base class of data matrices.
class DataMatrix {
  ; Returns row [index] as a data array for an Int, or the element at
  ; [index] for a tuple (row, col).
  declare method [](index)
  ; Sets the element at [index], a tuple (row, col), to [value].
  declare method []=(index, value)
  ; Returns the matrix's dimensions, (rows, cols).
  declare method shape() returns Tuple

  ; Returns the matrix's rows and shape, eliding the middle of large matrices.
  method to_s() {
    res = class().name() + '(['
    l = shape()[0]
    if l == 0 {
      return res + '])'
    }
    res.extend('\n  ')
    if l < 8 {
      for i = 0, i < l-1, i=i+1 {
        res.extend(str(self[i].to_arr()) + ',\n  ')
      }
      res.extend(str(self[l-1].to_arr()))
    } else {
      for i = 0, i < 5, i=i+1 {
        res.extend(str(self[i].to_arr()) + ',\n  ')
      }
      res.extend('...\n  ' + str(self[l-1].to_arr()))
    }
    return res + ']\n  shape=' + str(shape()) + ')'
  }
}