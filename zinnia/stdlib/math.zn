; Basic math functions.

; A very small number that is greater than 0.
self.EPSILON = 0.000001

; Pi approximated.
;
; The ratio of the circumference of the circle to its diameter.
; Note: This is only a constant approximation of pi at double precision.
;
self.PI = 3.141592653589793

; Euler's number approximated.
;
; It approximates the value of (1 + 1/n)*n as n approaches infinity. It is the
; base of natural logarithm.
;
self.E = exp(1)

; Returns the smallest number in [sequence].
function min(sequence) {
	m = sequence[0]
  for i=1, i < sequence.len(), i=i+1 {
    if sequence[i] < m {
      m = sequence[i]
    }
  }
  m
}

; Returns the largest number in [sequence].
function max(sequence) {
	m = sequence[0]
  for i=1, i < sequence.len(), i=i+1 {
    if sequence[i] > m {
      m = sequence[i]
    }
  }
  m
}

; Returns the value of [num] raised to [power], i.e., num^power.
; function pow(num, power) {}

; Returns the absolute value of [x].
; function abs(x) {}

; Returns the ceiling of [x].
; function ceil(x) {}

; Returns the floor of [x].
; function floor(x) {}

; Returns the logarithm of [x] with base [base], by default E.
function log(x, base=E) {
  __log(x, base)
}

; Returns the natural logarithm of [x].
function ln(x) {
  log(x)
}

; Returns the base-10 logarithm of [x].
function log10(x) {
  log(x, 10)
}

; Returns the square root of [x].
function sqrt(x) pow(x, 0.5)

; Returns the remainder of [n] divided by [d].
; function mod(n, d) {}

; Returns the tuple ([n] / [d], mod([n], [d])).
function div(n, d) {
  return (n / d, mod(n, d))
}

; Returns [n] / [d], or None if [d] is 0.
function safe_divide(n, d) {
  if d == 0 {
    return None
  }
  return n / d
}