; The builtin module: what every module can use without importing it.
;
; It defines str(), cat(), strfmt(), cmp(), hash() and the basic types
; (String, Array, Tuple, Range, Class, ...), and makes builtin_ext's
; iterators, range(), memoize() and sort() available. Its imports, such as io
; and error, are visible everywhere too.
;
; Much of it is defined natively, in C. Those functions, classes and methods
; are declared here with `declare`, which compiles to nothing.

import builtin_ext
import error
import io
import struct

; Returns [x] as an Int: a Float truncated, a Bool as 1 or 0, a Char as its
; code, a string parsed, and 0 for None. Raises an error for anything else.
declare function Int(x)

; Returns [x] as a Float.
declare function Float(x)

; Returns [x] as a Bool: False for None and False, and True for any other
; primitive, including 0. A string must be 'True', 'true', 'T' or 't', or
; 'False', 'false', 'F' or 'f'; anything else raises an error.
declare function Bool(x)

; Returns whether [x] is an Int.
declare function is_int(x)

; Returns whether [x] is a Float.
declare function is_float(x)

; Returns whether [x] is a Bool.
declare function is_bool(x)

; Returns the terminal escape sequence for the color [code], e.g. '31;1' for
; bold red, or that resets the color for 0 or None.
declare function color(code)

; Returns [input] as a String: itself if it's a string, its to_s() if it's an
; object, and its text otherwise, e.g. '3' for 3.
function str(input) {
  if is_string(input) {
    return input
  } else if (input is Object) {
    return input.to_s()
  } else {
    return __stringify(input)  ; Native C function
  }
}

; Returns the format string, the first of [args], with each '%' specifier
; replaced by the next of the rest of [args]:
; - %v: str(arg);
; - %d: as an Int;
; - %f: as a Float;
; - %b: as a Bool;
; - %p: an object's address, in hex;
; - %%: a '%'.
;
; Example: `strfmt('%v is %d', 'x', 3.0)` returns 'x is 3'.
;
; Raises an error for a missing format string or argument, a dangling '%' or an
; unknown specifier.
function strfmt(args) {
  ; A format string without arguments.
  if is_string(args) {
    args = [args]
  }
  if ~args or ~((args is Tuple) or (args is Array)) or (args.len() == 0) or ~is_string(args[0]) {
    raise error.Error(i'Expected fmt argument.')
  }
  out = ''
  fmt = args[0]
  args_i = 1
  for fmt_i = 0, fmt_i < fmt.len(), fmt_i = fmt_i + 1 {
    c = str(fmt[fmt_i])
    if c != i'%' {
      out.extend(c)
      continue
    }
    fmt_i = fmt_i + 1
    if fmt_i >= fmt.len() {
      raise error.Error(i'Format string ends with a dangling \'%\'.')
    }
    c = str(fmt[fmt_i])
    if c == i'%' {
      out.extend(i'%')
      continue
    }
    if args_i >= args.len() {
      raise error.Error(strfmt(i'Missing argument for \'%%%v\'.', c))
    }
    arg = args[args_i]
    if c == i'v' {
      out.extend(str(arg))
    } else if c == i'd' {
      out.extend(str(Int(arg)))
    } else if c == i'f' {
      out.extend(str(Float(arg)))
    } else if c == i'b' {
      out.extend(str(Bool(arg)))
    } else if c == i'p' {
      adr = if arg is Object then arg.$hex_addr() else i'0x000000000000'
      out.extend(adr)
    } else {
      raise error.Error(strfmt(i'Unknown fmt specifier \'%v\'', c))
    }
    args_i = args_i + 1
  }
  return out
}

; Returns the concatenation of str() of each of [args], e.g. cat('a', 1) is 'a1'.
function cat(args) {
  result = ''
  if ~(args is Tuple) {
    result.extend(str(args))
    return result
  }
  for i=0, i < args.len(), i=i+1 {
    result.extend(str(args[i]))
  }
  return result
}

; Returns a hash of [x]: [x].hash() for objects, and [x] as an Int otherwise.
function hash(x) {
  if x is Object {
    return x.hash()
  }
  return Int(x)
}

; Compares [o1] and [o2]: returns a negative number if [o1] comes first, 0 if
; they're equal and a positive number if [o2] comes first. Objects come before
; primitives, and an object's class can define __cmp__(other) to compare its
; instances.
function cmp(o1, o2) {
  if (o1 is Object) and ~(o2 is Object) {
    return -1
  }
  if (o2 is Object) and ~(o1 is Object) {
    return 1
  }
  if (o1 is Object) and o1.class().__cmp__ {
    return o1.__cmp__(o2)
  }
  if o1 == o2 {
     return 0
  }
  if o2 > o1 {
    return -1
  }
  return 1
}

; Returns [args], an Array, as a Tuple, or [args] itself if it's a Tuple.
function tuple(args) {
  if args is Tuple {
    return args
  } else if ~(args is Array) {
    raise error.Error('Cannot tuple something not an Array.')
  }
  t = __tuple(args)
  return t
}

; The class every class extends.
class Object {
  ; Returns the object's class.
  declare method class()
  ; Returns the constructor of [cls], a class this object's class extends,
  ; for calling it from a constructor: `super(Base)(args)`.
  declare method super(cls)
  ; Returns a hash of the object.
  declare method hash()
  ; Returns a copy of the object.
  declare method copy()
  ; Returns the member [name] of the object, or None.
  declare method $get(name)
  ; Sets the member [name] of the object to [value].
  declare method $set(name, value)
  ; Returns the object's address, as an Int.
  declare method $adr()
  ; Returns the object's address, in hexadecimal.
  declare method $hex_addr()

  ; Returns e.g. 'Instance of module.Class'.
  method to_s() {
    return cat(
        'Instance of ',
        self.class().module().name(),
        '.',
        self.class().name())
  }
}

; A module.
class Module {
  ; Returns the module's name.
  declare method name()
  ; Returns the module's functions.
  declare method functions()
  ; Returns the module's classes.
  declare method classes()
  ; Returns the file the module was loaded from.
  declare method filename()
  ; Returns the module's source file, if it was loaded with a source map.
  declare method source_filename()
  ; Returns whether the module is a C library loaded with
  ; dynamic.import_c_library().
  declare method has_dl()
  ; Calls the C library's function [fn_name] with [args].
  declare method dlcall(fn_name, args)

  ; Returns e.g. 'Module(io)'.
  method to_s() {
    return cat('Module(', name(), ')')
  }
}

; A class.
class Class {
  ; Returns the class's name.
  declare method name()
  ; Returns the module the class is defined in.
  declare method module()
  ; Returns the class this class extends, or None.
  declare method super()
  ; Returns the names of the class's fields.
  declare method fields()
  ; Returns the class's methods, but not those of the classes it extends.
  declare method methods()
  ; Returns whether this class extends [cls], directly or not.
  declare method is_subclass_of(cls)

  field annotations
  ; Returns e.g. 'class Foo', followed by its annotations.
  method to_s() {
    if annotations.len() > 0 {
      cls_name =  'class ' + name()
      for (_, a) in annotations {
        cls_name = cls_name + ' @' + str(a.class().name())
      }
      return cls_name
    } else {
      return cat('class ', name())
    }
  }
  ; Adds [annot] to the class's annotations.
  method add_annotation(annot) {
    annotations.append(annot)
  }
  ; Returns the class's annotations.
  method all_annotations() {
    return annotations
  }
  ; Returns the methods of the class and the classes it extends.
  method all_methods() {
    meths = methods()
    sup = super()
    while sup {
      sup.methods().each(m -> meths.append(m))
      sup = sup.super()
    }
    return meths
  }
}

; Returns whether [e] is a String or an IString.
function is_string(e) {
  (e is String) or (e is IString)
}

; A mutable string.
class String {
  ; Returns the character at index [i].
  declare method [](i)
  ; Sets the character at index [i] to [c].
  declare method []=(i, c)
  ; Returns the string's length.
  declare method len()
  ; Appends the string [s] to this string, and returns this string.
  declare method extend(s)
  ; Returns a copy of the string.
  declare method copy()
  ; Returns the string without leading and trailing whitespace.
  declare method trim()
  ; Returns the string without leading whitespace.
  declare method ltrim()
  ; Returns the string without trailing whitespace.
  declare method rtrim()
  ; Removes [n] characters from the start of the string.
  declare method lshrink(n)
  ; Removes [n] characters from the end of the string.
  declare method rshrink(n)
  ; Returns the parts of the string between occurrences of [delim], as an
  ; Array.
  declare method split(delim)

  ; Returns the string itself.
  method to_s() {
    return self
  }
  ; Returns str() of each of [strs], with this string between them.
  method join(strs) {
    result = ''
    if strs.len() == 0 {
      return result
    }
    result.extend(str(strs[0]))
    for i=1, i<strs.len(), i=i+1 {
      result.extend(self)
      result.extend(str(strs[i]))
    }
    return result
  }
  ; Returns the [num_chars] characters from [start_index], or all of them to
  ; the end if [num_chars] is None.
  method substr(start_index, num_chars=None) {
    if ~num_chars {
      num_chars = len() - start_index
    }
    end_index = start_index + num_chars
    if start_index <= end_index {
      return __substr(start_index, end_index)
    }
    return __substr(end_index, start_index)
  }
  ; Returns the index of the first [sub] at or after [index], or None.
  method find(sub, index=0) {
    __find(sub, index)
  }
  ; Returns the indices of every [sub] at or after [index].
  method find_all(sub, index=0) {
    __find_all(sub, index)
  }
  ; Returns whether [sub] is in the string, for `sub in s`.
  method __in__(sub) {
    find(sub) != None
  }
  ; Returns whether the string starts with [other], which must be a string.
  method starts_with(other) {
    if ~is_string(other) {
      return False
    }
    return __starts_with(other)
  }
  ; Returns whether the string ends with [other], which must be a string.
  method ends_with(other) {
    if ~is_string(other) {
      return False
    }
    return __ends_with(other)

  }
}

; An immutable, interned string, written i'text'.
class IString {
  ; Returns the character at index [i].
  declare method [](i)
  ; Returns the string's length.
  declare method len()
  ; Returns a mutable String copy of the string.
  declare method copy()
  ; Returns the string without leading and trailing whitespace.
  declare method trim()
  ; Returns the string without leading whitespace.
  declare method ltrim()
  ; Returns the string without trailing whitespace.
  declare method rtrim()
  ; Returns the parts of the string between occurrences of [delim], as an
  ; Array.
  declare method split(delim)
  ; Returns the string as a String.
  declare method to_s()

  ; Returns str() of each of [strs], with this string between them.
  method join(strs) {
    result = ''
    if strs.len() == 0 {
      return result
    }
    result.extend(str(strs[0]))
    for i=1, i<strs.len(), i=i+1 {
      result.extend(self)
      result.extend(str(strs[i]))
    }
    return result
  }
  ; Returns the [num_chars] characters from [start_index], or all of them to
  ; the end if [num_chars] is None.
  method substr(start_index, num_chars=None) {
    if ~num_chars {
      num_chars = len() - start_index
    }
    end_index = start_index + num_chars
    if start_index <= end_index {
      return __substr(start_index, end_index)
    }
    return __substr(end_index, start_index)
  }
  ; Returns the index of the first [sub] at or after [index], or None.
  method find(sub, index=0) {
    __find(sub, index)
  }
  ; Returns the indices of every [sub] at or after [index].
  method find_all(sub, index=0) {
    __find_all(sub, index)
  }
  ; Returns whether [sub] is in the string, for `sub in s`.
  method __in__(sub) {
    find(sub) != None
  }
  ; Returns whether the string starts with [other], which must be a string.
  method starts_with(other) {
    if ~is_string(other) {
      return False
    }
    return __starts_with(other)
  }
  ; Returns whether the string ends with [other], which must be a string.
  method ends_with(other) {
    if ~is_string(other) {
      return False
    }
    return __ends_with(other)
  }
}

; An immutable sequence, written (a, b).
class Tuple {
  ; Returns how many elements the tuple has.
  declare method len()

  ; Returns whether [other] is a Tuple with equal elements.
  method ==(other) {
    if (~(other is Tuple) or len() != other.len()) return False
    for i=0, i<len(), i=i+1 {
      if (self[i] != other[i]) {
        return False
      }
    }
    return True
  }
  ; Returns whether [other] isn't a Tuple with equal elements.
  method !=(other) {
    return ~(self == other)
  }
  ; Returns e.g. "(1, 'a')".
  method to_s() {
    if len() == 0 {
      return '()'
    }
    result = '('
    result.extend(_maybe_wrap_in_quotes(self[0]))
    for i = 1, i < len(), i = i + 1 {
      result.extend(', ')
          .extend(_maybe_wrap_in_quotes(self[i]))
    }
    result.extend(')')
    return result
  }
  ; Returns an iterator over the (index, element) pairs.
  method iter() {
    return IndexIterator(self, 0, len())
  }
  ; Returns str([elt]), in quotes if it's a string.
  method _maybe_wrap_in_quotes(elt) {
    if is_string(elt) {
      return '\''.extend(elt).extend('\'')
    } else {
      return str(elt)
    }
  }
}

; A growable sequence, written [a, b].
class Array {
  ; Returns how many elements the array has.
  declare method len()
  ; Adds [value] to the end of the array.
  declare method append(value)

  ; Returns whether [other] is an Array with equal elements.
  method ==(other) {
    if (~(other is Array) or len() != other.len()) return False
    for i=0, i<len(), i=i+1 {
      if (self[i] != other[i]) {
        return False
      }
    }
    return True
  }
  ; Returns whether [other] isn't an Array with equal elements.
  method !=(other) {
    return ~(self == other)
  }
  ; Removes and returns the element at index [i]; raises an error if it's out of bounds.
  method remove(i) {
    i = Int(i)
    if i >= len() or i < 0 {
      raise error.Error(cat('Index is out of bounds: ', i, ', Array length: ', len()))
    }
    return __remove(i)
  }
  ; Removes the first element equal to [v], and returns whether there was one.
  method remove_value(v) {
    for i=0, i<len(), i=i+1 {
      if self[i] == v {
        remove(i)
        return True
      }
    }
    return False
  }
  ; Returns e.g. "[1, 'a']".
  method to_s() {
    result = '['
    result.extend(', '.join(map((elt) {
      if is_string(elt) {
        return '\''.extend(elt).extend('\'')
      } else {
        return str(elt)
      }
    })))
    return result.extend(']')
  }
  ; Calls [fn] with each element.
  method each(fn) {
    for i=0, i<len(), i=i+1 {
      fn(self[i])
    }
  }
  ; Returns an Array of [fn] applied to each element.
  method map(fn) {
    result = []
    if len() == 0 {
      return result
    }
    result[len()-1] = None
    for i=0, i<len(), i=i+1 {
      result[i] = fn(self[i])
    } 
    return result
  }
  ; Returns an Array of the elements for which [filter_fn] returns a true value.
  method where(filter_fn) {
    result = []
    for i=0, i<len(), i=i+1 {
      if filter_fn(self[i]) {
        result.append(self[i])
      }
    } 
    return result
  }
  ; Returns how many elements [filter_fn] returns a true value for.
  method count(filter_fn) {
    result = 0
    for i=0, i<len(), i=i+1 {
      if filter_fn(self[i]) {
        result = result + 1
      }
    }
    return result
  }
  ; Returns whether [has_fn] returns a true value for any element.
  method has(has_fn) {
    for i=0, i<len(), i=i+1 {
      if has_fn(self[i]) {
        return True
      }
    }
    return False
  }
  ; Folds the elements with [f](accumulated, element), starting from [s], or
  ; from the first element if [s] is None, and returns the result. [s] may be a
  ; function that returns the starting value.
  ;
  ; Example: `[1, 2, 3].collect((a, b) -> a + b)` returns 6.
  method collect(f, s=None) {
    if len() == 0 {
      if s is Function {
        return s()
      } else {
        return s
      }
    }
    i = 0
    a = None
    if s {
      if s is Function {
        a = s()
      } else {
        a = s
      }
    } else {
      a = self[0]
      i = 1
    }
    for _, i<len(), i=i+1 {
      a = f(a, self[i])
    }
    return a
  }
  ; Returns an iterator over the (index, element) pairs.
  method iter() {
    return IndexIterator(self)
  }
}

; A function or method. [annotations] holds its annotations.
class Function {
  ; Returns the function's name.
  declare method name()
  ; Returns the module the function is defined in.
  declare method module()
  ; Returns whether the function is a method.
  declare method is_method()
  ; Returns the class a method is defined in, or None for a function.
  declare method parent_class()

  ; Returns e.g. 'Function(module.name)' or 'Method(module.Class.name)'.
  method to_s() {
    res = None
    if self.is_method() {
      res = cat(
          'Method(',
          self.module().name(),
          '.', self.parent_class().name(),
          '.', self.name())
    } else {
      res = cat('Function(', self.module().name(), '.', self.name())
    }
    if self.annotations and self.annotations.len() > 0 {
      res.extend(', annotations=')
      res.extend(str(self.annotations))
    }
    res.extend(')')
    res
  }
  ; Adds [annot] to the function's annotations.
  method add_annotation(annot) {
    self.annotations.append(annot)
  }
}

; A method bound to an object, as `obj.method` without a call gives.
class FunctionRef {
  ; Returns the method's name.
  declare method name()
  ; Returns the module the method is defined in.
  declare method module()
  ; Returns the object the method is bound to.
  declare method obj()
  ; Returns the method, as a Function.
  declare method func()

  ; Returns e.g. 'FunctionRef(obj=...,func=...)'.
  method to_s() {
    cat('FunctionRef(obj=', self.obj(), ',func=', self.func(), ')')
  }
}

; A sequence of integers from start() up to but not including end(), counting
; by inc(). Create one with range(start, end) or range(start, inc, end).
class Range {
  ; Creates a range counting from [start] by [inc] up to but not including
  ; [end].
  declare new(start, inc, end)
  ; Returns the first integer of the range.
  declare method start()
  ; Returns the amount the range counts by.
  declare method inc()
  ; Returns the end of the range, which it doesn't include.
  declare method end()

  ; Returns 'start:inc:end'.
  method to_s() {
    cat(start(), ':', inc(), ':', end())
  }
  ; The end of a range is exclusive: 0:10:3 contains 0, 3, 6 and 9.
  method __in__(n) {
    if ~is_int(n) {
      return False
    }
    d = n - start()
    if d % inc() != 0 {
      return False
    }
    i = d / inc()
    return i >= 0 and i < len()
  }
  ; Returns the [i]-th integer of the range; raises an error if [i] is out of bounds.
  method [](i) {
    if i < 0 or i >= len() {
      raise error.Error(cat('Range index out of bounds. was ', i))
    }
    return start() + i * inc()
  }
  ; Returns how many integers the range has.
  method len() {
    span = end() - start()
    step = inc()
    if step < 0 {
      span = -span
      step = -step
    }
    if span <= 0 {
      return 0
    }
    return ((span + step - 1) / step)
  }
  ; Returns an iterator over the (index, integer) pairs.
  method iter() {
    IndexIterator(self, 0, len())
  }
}

; See builtin_ext.Iterator.
; Runs a function in an isolate of its own. Create one with
; async.spawn_isolate().
declare class Isolate {
  ; Starts the isolate, and returns a future to the result of its function.
  method start()
}

; A reference to an actor in another isolate, which the proxies that
; async.spawn_actor() returns send calls to.
declare class ActorRef {
  ; Returns the isolate the actor lives in.
  method isolate()
}

; A frame of the call stack, defined natively.
declare class Frame {}

; A scope of variables, defined natively.
declare class Scope {}

self.Iterator = builtin_ext.Iterator
; See builtin_ext.IndexIterator.
self.IndexIterator = builtin_ext.IndexIterator
; See builtin_ext.KVIterator.
self.KVIterator = builtin_ext.KVIterator
; See builtin_ext.range().
self.range = builtin_ext.range
; See builtin_ext.memoize().
self.memoize = builtin_ext.memoize
; See builtin_ext.sort().
self.sort = builtin_ext.sort
