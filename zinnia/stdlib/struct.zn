; Data structures: hash maps, sets, caches and sorted sets.
;
; `{k: v}` literals create Maps.

import builtin
import math

; A hash map. Keys need `==` and builtin.hash(); a class can define `==` and
; hash() for its own.
;
; Iterating gives (key, value) pairs in the order the keys were added.
;
; Example:
; ```
; m = {'a': 1}
; m['b'] = 2
; for (k, v) in m {
;   io.println(cat(k, '=', v))
; }
; ```
class Map {
  field table, keys
  ; Creates an empty map with [sz] buckets.
  new(field sz=31) {
    table = []
    table[sz] = None
    keys = []
  }
  ; Returns the bucket of [k].
  method _hash(k) {
    hval = builtin.hash(k)
    pos = hval % sz
    if pos < 0 pos = -pos
    return pos
  }
  ; Associates [k] with [v], and returns the value [k] had before, or None.
  method []=(k, v) {
    pos = _hash(k)
    entries = table[pos]
    if ~entries {
      table[pos] = [(k,v)]
      keys.append(k)
      return None
    }
    for i=0, i<entries.len(), i=i+1 {
      if k == entries[i][0] {
        old_v = entries[i][1]
        entries[i] = (k,v)
        return old_v
      }
    }
    entries.append((k,v))
    keys.append(k)
    return None
  }
  ; Returns the value associated with [k], or None.
  method [](k) {
    pos = _hash(k)
    entries = table[pos]
    if ~entries {
      return None
    }
    for i=0, i<entries.len(), i=i+1 {
      if k == entries[i][0] {
        return entries[i][1]
      }
    }
    return None
  }
  ; Returns whether the map has an entry for [k], for `k in map`.
  method __in__(k) {
    entries = table[_hash(k)]
    if ~entries {
      return False
    }
    for i=0, i<entries.len(), i=i+1 {
      if k == entries[i][0] {
        return True
      }
    }
    return False
  }
  ; Removes the entry for [k], and returns its value, or None if there was none.
  method remove(k) {
    pos = _hash(k)
    entries = table[pos]
    if ~entries {
      return None
    }
    for i=0, i<entries.len(), i=i+1 {
      if k == entries[i][0] {
        old_v = entries[i][1]
        entries.remove(i)
        keys.remove_value(k)
        return old_v
      }
    }
    return None
  }
  ; Returns the value associated with [k], or [d] if there's none.
  method get_or_default(k, d) {
    if k in self {
      return self[k]
    }
    return d
  }
  ; Returns the value associated with [k], or [fn]([k]) if there's none.
  method get_or_else(k, fn) {
    if k in self {
      return self[k]
    }
    return fn(k)
  }
  ; Associates [k] with [v] unless the map has an entry for [k].
  method put_if_absent(k, v) {
    if ~(k in self) {
      self[k] = v
    }
  }
  ; Associates [k] with [remapping_fn]([k], its current value or None) and
  ; returns the new value. If that's None or False, removes [k] instead.
  method compute(k, remapping_fn) {
    old_value = self[k]
    new_value = remapping_fn(k, old_value)
    if new_value {
      self[k] = new_value
    } else if old_value {
      remove(k)
    }
    return new_value
  }
  ; If the map has no entry for [k], associates it with [mapping_fn]([k]) unless
  ; that's None or False, and returns it; otherwise returns None.
  method compute_if_absent(k, mapping_fn) {
    if ~(k in self) {
      new_value = mapping_fn(k)
      if new_value {
        self[k] = new_value
      }
      return new_value
    }
    return None
  }
  ; If [k] has a value, associates it with [remapping_fn]([k], value), or removes
  ; it if that's None or False, and returns the new value; otherwise returns
  ; None.
  method compute_if_present(k, remapping_fn) {
    old_value = self[k]
    if old_value {
      new_value = remapping_fn(k, old_value)
      if new_value {
        self[k] = new_value
      } else {
        remove(k)
      }
      return new_value
    }
    return None
  }
  ; Returns an iterator over the (key, value) pairs.
  method iter() {
    return KVIterator(keys.iter(), self)
  }
  ; Calls [f](key, value) for each entry.
  method each(f) {
    for (k, v) in self {
      f(k, v)
    }
  }
  ; Returns e.g. "{'a': 1, 'b': 2}".
  method to_s() {
    kvs = []
    each((k, v) {
      key = if is_string(k) then '\''.extend(k).extend('\'') else str(k)
      value = if is_string(v) then '\''.extend(v).extend('\'') else str(v)
      kvs.append(cat(key, ': ', value))
    })
    return cat('{', ', '.join(kvs), '}')
  }
}


; Caches the values a factory function computes for keys.
class Cache {
  field map
  ; Creates an empty cache, with a Map of [sz] buckets.
  new(sz=31) {
    map = Map(sz)
  }
  ; Returns the cached value for [k], or computes it with [factory]([k]) and
  ; caches it. If [factory] raises an error, caches and returns [default].
  method get(k, factory, default=None) {
    if k in map {
      return map[k]
    }
    v = None
    try {
      v = factory(k)
    } catch e {
      v = default
    }
    map[k] = v
    return v
  }
  ; Removes the cached value for [k], or every cached value if [k] is None.
  method clear(k=None) {
    if k == None {
      map = Map(map.sz)
    } else {
      map.remove(k)
    }
  }
}

; A Cache with its factory function.
class LoadingCache {
  ; Creates a cache of values that [factory] computes, kept in [cache].
  new({field cache=Cache(255), field factory}) {}
  ; Returns the cached value for [k], computing it with the factory the first time.
  method get(k) {
    cache.get(k, factory) 
  }

  ; Removes the cached value for [k], or every cached value if [k] is None.
  method clear(k=None) {
    cache.clear(k)
  }
}

; A collection that contains no duplicate elements.
class Set {
  field map
  ; Creates an empty set, with a Map of [sz] buckets.
  new(sz=255) {
    map = Map(sz)
  }
  ; Inserts [k] into the set.
  method insert(k) {
    map[k] = k
  }
  ; Removes [k] from the set.
  method remove(k) {
    map.remove(k)
  }
  ; Returns whether [k] is in the set, for `k in set`.
  method __in__(k) {
    k in map
  }
}

; A node of a TreeSet.
class _TreeNode {
  field left, right, height
  ; Creates a leaf node holding [value].
  new(field value) {
    left = None
    right = None
    height = 1
  }
  
  ; Returns e.g. '_TreeNode(3)'.
  method to_s() {
    '_TreeNode(' + str(value) + ')'
  }
}

; Stores a set of comparable values in a self-balancing binary tree.
; 
; Properties
;   Insertion: O(logN)
;   Removal:   O(logN)
;   Lookup:    O(logN)
;   Traversal: O(N)
;   Sorting:   O(N) - to construct list
;
; This is implemented as a classic AVL Tree which incrementally balances during
; insertion.
class TreeSet {
  field root
  ; Creates an empty tree.
  new() {
    root = None
  }

  ; Inserts [v] into the tree.
  ; O(logN)
  method insert(v) {
    root = _insert_helper(v, root)
  }

  ; Inserts all members of [l] into the tree.
  ; O(N*logN)
  method insert_all(l) {
    for i=0, i < l.len(), i=i+1 {
      insert(l[i])
    }
  }

  ; Inserts [v] into the subtree at [node] and returns the subtree's rebalanced root.
  method _insert_helper(v, node) {
    if ~node {
      return _TreeNode(v)
    }
    if v < node.value {
      node.left = _insert_helper(v, node.left)
    } else {
      node.right = _insert_helper(v, node.right)
    }

    node.height = 1 + math.max(_height(node.left), _height(node.right))

    balance = _balance(node)
    if balance > 1 {
      if v >= node.left.value {
        node.left =  _rotate_left(node.left)
      }
      return _rotate_right(node)
    } else if balance < -1 {
      if v <= node.right.value {
        node.right = _rotate_right(node.right)
      }
      return _rotate_left(node)
    }
    node
  }

  ; Removes [v] from the tree.
  ; O(logN)
  method remove(v) {
    root = _remove_helper(v, root)
  }

  ; Removes [v] from the subtree at [node] and returns the subtree's rebalanced root.
  method _remove_helper(v, node) {
    if ~node {
      return node
    } else if v < node.value {
      node.left = _remove_helper(v, node.left)
    } else if v > node.value {
      node.right = _remove_helper(v, node.right)
    } else {
      if ~node.left {
        return node.right
      } else if ~node.right {
        return node.left
      }
      temp = _min_value_node(node.right)
      node.value = temp.value
      node.right = _remove_helper(temp.value, node.right)
    }
    
    node.height = 1 + math.max(_height(node.left), _height(node.right))

    balance = _balance(node)

    if balance > 1 {
      if _balance(node.left) >= 0 {
        return _rotate_right(node)
      } else {
        node.left = _rotate_left(node.left)
        return _rotate_right(node)
      }
    } else if balance < -1 {
      if _balance(node.right) <= 0 {
        return _rotate_left(node)
      } else {
        node.right = _rotate_right(node.right)
        return _rotate_left(node)
      }
    }
    node
  }

  ; Returns whether [v] is in the tree, for `v in tree`.
  ; O(logN)
  method __in__(v) {
    _in(v, root)
  }

  ; Returns whether [v] is in the subtree at [node].
  method _in(v, node) {
    if ~node {
      return False
    }
    c = builtin.cmp(v, node.value)
    if c == 0 {
      return True
    }
    if c < 0 and _in(v, node.left) {
      return True
    }
    if c > 0 and _in(v, node.right) {
      return True
    }
    return False
  }

  ; Returns the node with the smallest value in the subtree at [node].
  method _min_value_node(node) {
    if ~node or ~node.left {
      return node
    }
    _min_value_node(node.left)
  }

  ; Returns the height of the subtree at [node], 0 for None.
  method _height(node) {
    if ~node {
      return 0
    }
    return node.height
  }

  ; Returns how much taller the left subtree of [node] is than the right.
  method _balance(node) {
    if ~node {
      return 0
    }
    return _height(node.left) - _height(node.right)
  }

  ; Rotates the subtree at [node] left and returns its new root.
  method _rotate_left(node) {
    y = node.right
    t2 = y.left
    y.left = node
    node.right = t2
    node.height = 1 + math.max(_height(node.left), _height(node.right))
    y.height = 1 + math.max(_height(y.left), _height(y.right))
    return y
  }

  ; Rotates the subtree at [node] right and returns its new root.
  method _rotate_right(node) {
    y = node.left
    t3 = y.right
    y.right = node
    node.left = t3
    node.height = 1 + math.max(_height(node.left), _height(node.right))
    y.height = 1 + math.max(_height(y.left), _height(y.right))
    return y
  }

  ; Appends the values of the subtree at [node] to [arr] in sorted order.
  method _inorder(node, arr) {
    if ~node {
      return
    }
    _inorder(node.left, arr)
    arr.append(node.value)
    _inorder(node.right, arr)
  }

  ; Returns a sorted-order Array of the elements.
  ; O(N)
  method sorted() {
    arr = []
    _inorder(root, arr)
    return arr
  }

  ; Returns an iterator over the tree elements in sorted order.
  ; O(N)
  method iter() {
    IndexIterator(sorted())
  }
}
