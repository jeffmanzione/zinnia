; Network sockets over TCP/IP.
;
; Example:
; ```
; server = socket.create_server_socket(socket.lookup_local_address(), 8080)
; handle = await server.accept()
; io.println(await handle.receive())
; await handle.send('Hello')
; handle.close()
; server.close()
; ```

import io

; The value socket calls return on errors.
self.SOCKET_ERROR = -1
; The IPv4 address family.
self.AF_INET = 2
; Binds a server to all of this machine's addresses.
self.INADDR_ANY = 0
; A stream (TCP) socket.
self.SOCK_STREAM = 1

; Initializes the platform's socket library.
__init()

; Returns this machine's address.
function lookup_local_address() {
  return __lookup_local_address()
}

; Returns a TCP server socket bound to [host] and [port].
function create_server_socket(host, port) {
  return Socket(AF_INET, SOCK_STREAM, 0, host, port, True)
}

; Returns a TCP client socket for [host] and [port]; call connect() to connect.
function create_client_socket(host, port) {
  return Socket(AF_INET, SOCK_STREAM, 0, host, port, False)
}

; Releases the platform's socket library.
function cleanup() {
  __cleanup()
}

; A socket, defined natively. Create one with create_server_socket() or
; create_client_socket().
declare class Socket {
  ; Creates a socket of the address [family] and [type] with [protocol], for
  ; [host] and [port], which listens for connections if [is_server].
  new(family, type, protocol, host, port, is_server)
  ; Returns the host the socket is bound or connected to.
  method host()
  ; Returns the port the socket is bound or connected to.
  method port()
  ; For a server socket, returns a future to the next connection, as a
  ; SocketHandle.
  method accept()
  ; For a client socket, connects, and returns a future to the connection, as
  ; a SocketHandle.
  method connect()
  ; Closes the socket.
  method close()
}

; One side of a connection, defined natively.
declare class SocketHandle {
  ; Sends [text], and returns a future that completes once it's sent.
  method send(text)
  ; Returns a future to the next text received, or to None once the
  ; connection is closed.
  method receive()
  ; Closes the connection.
  method close()
}
