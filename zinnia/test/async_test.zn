import async
import error
import test

self.expect = test.expect

test.Tester().test(self)

@async.Actor
class Counter {
  field count
  new() {
    count = 0
  }
  method inc() {
    count = count + 1
    return count
  }
  method fail() {
    raise error.Error('intentional')
  }
}

@async.Actor
class FailsToConstruct {
  new() {
    raise error.Error('intentional')
  }
  method get() {
    return 1
  }
}

def raise_error(x) {
  raise error.Error(x)
}

def side_task() async {
  await async.sleep(0.05)
  return 'side'
}

def start_side_task(x) {
  side_task()
  return x
}

@async.Actor
class Relay {
  new() {}
  method inc_other(other, n) {
    for i=0, i<n, i=i+1 {
      await other.inc()
    }
    return n
  }
}

@async.RemoteClass
class OldCounter {
  field count
  new() {
    count = 0
  }
  method inc() {
    count = count + 1
    return count
  }
}

@test.TestClass
class FutureTest {
  @test.Test
  method test_sleep() {
    expect(await async.sleep(0.01), None)
  }

  @test.Test
  method test_await_already_failed_future_raises() {
    f = (() async {
      raise error.Error('failed')
    })()
    await async.sleep(0.05)
    test.expect_raises(() -> await f)
  }

  @test.Test
  method test_failed_async_call_does_not_affect_caller() {
    (() async {
      raise error.Error('ignored')
    })()
    await async.sleep(0.01)
    expect(1 + 1, 2)
  }

  @test.Test
  method test_all() {
    f = (x) async -> x * 2
    expect(await async.all([f(1), f(2), f(3)]), [2, 4, 6])
  }
}

@test.TestClass
class CompleterTest {
  @test.Test
  method test_complete_before_await() {
    c = async.Completer()
    c.complete(5)
    expect(c.completed, True)
    expect(await c.as_future(), 5)
  }

  @test.Test
  method test_complete_after_await() {
    c = async.Completer()
    () async {
      await async.sleep(0.01)
      c.complete('done')
    }()
    expect(c.completed, False)
    expect(await c.as_future(), 'done')
    expect(c.completed, True)
  }

  @test.Test
  method test_complete_without_value() {
    c = async.Completer()
    c.complete()
    expect(await c.as_future(), None)
  }

  @test.Test
  method test_complete_twice_raises() {
    c = async.Completer()
    c.complete(1)
    test.expect_raises(() -> c.complete(2))
    expect(await c.as_future(), 1)
  }
}

@test.TestClass
class IsolateTest {
  @test.Test
  method test_spawn_isolate() {
    isolate = async.spawn_isolate(fn: (x) -> x * 2, args: 21)
    expect(await isolate.start(), 42)
  }

  @test.Test
  method test_spawn_isolate_returns_objects() {
    isolate = async.spawn_isolate(fn: (x) -> [x, cat(x, '!')], args: 'hi')
    expect(await isolate.start(), ['hi', 'hi!'])
  }

  @test.Test
  method test_spawn_isolate_error_propagates() {
    isolate = async.spawn_isolate(fn: raise_error, args: 'intentional')
    test.expect_raises(() -> await isolate.start())
  }

  @test.Test
  method test_spawn_isolate_returns_start_function_result() {
    isolate = async.spawn_isolate(fn: start_side_task, args: 'result')
    expect(await isolate.start(), 'result')
  }

  @test.Test
  method test_create_process_alias() {
    process = async.create_process(fn: (x) -> x + 1, args: 1)
    expect(await process.start(), 2)
  }
}

@test.TestClass
class ActorTest {
  @test.Test
  method test_spawn_actor() {
    counter = async.spawn_actor(Counter)
    test.expect_is(counter, CounterProxy)
    expect(await counter.inc(), 1)
    expect(await counter.inc(), 2)
    test.expect_is(counter.target(), ActorRef)
  }

  @test.Test
  method test_actor_constructor_error_propagates() {
    test.expect_raises(() -> async.spawn_actor(FailsToConstruct))
  }

  @test.Test
  method test_actor_errors_propagate() {
    counter = async.spawn_actor(Counter)
    test.expect_raises(() -> await counter.fail())
  }

  @test.Test
  method test_actor_error_raised_when_awaited_late() {
    counter = async.spawn_actor(Counter)
    f = counter.fail()
    await async.sleep(0.1)
    test.expect_raises(() -> await f)
  }

  @test.Test
  method test_concurrent_calls() {
    counter = async.spawn_actor(Counter)
    calls = []
    for i=0, i<50, i=i+1 {
      calls.append(counter.inc())
    }
    results = await async.all(calls)
    expect(results.len(), 50)
    expect(await counter.inc(), 51)
  }

  @test.Test
  method test_actors_calling_each_other() {
    a = async.spawn_actor(Counter)
    b = async.spawn_actor(Counter)
    a_relay = async.spawn_actor(Relay)
    b_relay = async.spawn_actor(Relay)
    expect(
        await async.all([a_relay.inc_other(b, 20), b_relay.inc_other(a, 20)]),
        [20, 20])
    expect(await a.inc(), 21)
    expect(await b.inc(), 21)
  }

  @test.Test
  method test_missing_method_raises() {
    counter = async.spawn_actor(Counter)
    test.expect_raises(
        () -> async.__actor_call(counter.target(), 'missing', None))
  }

  @test.Test
  method test_deprecated_aliases() {
    counter = async.create_remote(OldCounter)
    test.expect_is(counter, OldCounterProxy)
    test.expect_is(counter, RemoteOldCounter)
    expect(await counter.inc(), 1)
    test.expect_is(counter.remote(), ActorRef)
  }
}
