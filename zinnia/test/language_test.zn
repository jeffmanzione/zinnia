import classes as class_lib
import error
import test

self.expect = test.expect

test.Tester().test(self)

class Defaults {
  new(field a = 1, field b = 2) {}
}

function defaults(p = 10, q = 20, r = 30) {
  return (p, q, r)
}

; Generates class GeneratedBase in the annotated class's module.
class GenerateBase {
  method annotate(cls) {
    builder = class_lib.factory.create_class('GeneratedBase', cls.module())
    builder.add_method('base_value').with_statement('return 42')
    builder.build()
  }
}

@GenerateBase
class Generator {}

; Extends a class that only exists after annotations have run.
class ExtendsGenerated : GeneratedBase {}

@test.TestClass
class DefaultArgumentsTest {
  @test.Test
  method test_constructor_defaults() {
    d = Defaults()
    expect(d.a, 1)
    expect(d.b, 2)
  }

  @test.Test
  method test_constructor_partial_defaults() {
    d = Defaults(5)
    expect(d.a, 5)
    expect(d.b, 2)
  }

  @test.Test
  method test_function_defaults() {
    expect(defaults(), (10, 20, 30))
    expect(defaults(1), (1, 20, 30))
    expect(defaults(1, 2), (1, 2, 30))
    expect(defaults(1, 2, 3), (1, 2, 3))
  }
}

@test.TestClass
class ExpectTest {
  @test.Test
  method test_expect_not() {
    test.expect_not(1, 2)
    test.expect_raises(() -> test.expect_not(1, 1), test.ExpectError)
  }
}

@test.TestClass
class GeneratedSuperclassTest {
  @test.Test
  method test_extends_generated_class() {
    expect(ExtendsGenerated().base_value(), 42)
  }
}

@test.TestClass
class EqualityTest {
  @test.Test
  method test_none_variables() {
    a = None
    b = None
    expect(a == b, True)
    expect(a != b, False)
    expect(None == a, True)
    expect(a == None, True)
    expect(None != a, False)
  }

  @test.Test
  method test_none_and_primitive() {
    n = None
    one = 1
    expect(n == one, False)
    expect(one == n, False)
    expect(n == 1, False)
    expect(n != 1, True)
    expect(1 == n, False)
    expect(1 != n, True)
  }

  @test.Test
  method test_none_and_object() {
    n = None
    s = 'a'
    expect(n == s, False)
    expect(s == n, False)
    expect(n != s, True)
  }

  @test.Test
  method test_primitive_and_object() {
    one = 1
    s = 'a'
    expect(s == 1, False)
    expect(1 == s, False)
    expect(one == s, False)
    expect(s != 1, True)
    expect(1 != s, True)
  }

  @test.Test
  method test_primitives() {
    one = 1
    other_one = 1
    two = 2
    expect(one == other_one, True)
    expect(one == two, False)
    expect(one != two, True)
    expect(one == 1.0, True)
  }

  @test.Test
  method test_expect_none() {
    expect(None, None)
  }
}

@test.TestClass
class ErrorPropagationTest {
  @test.Test
  method test_closure_error_caught_by_caller() {
    caught = None
    try {
      (() { raise error.Error('closure') })()
    } catch e {
      caught = e.message
    }
    expect(caught, 'closure')
  }

  @test.Test
  method test_callback_error_caught_by_caller() {
    caught = None
    try {
      [1, 2].map((i) { raise error.Error('callback ' + str(i)) })
    } catch e {
      caught = e.message
    }
    expect(caught, 'callback 1')
  }

  @test.Test
  method test_error_caught_inside_closure() {
    r = (() {
      try {
        raise error.Error('inside')
      } catch e {
        return 'handled ' + e.message
      }
    })()
    expect(r, 'handled inside')
  }

  @test.Test
  method test_execution_continues_in_order() {
    order = []
    try {
      (() { raise error.Error('x') })()
    } catch e {
      order.append(1)
    }
    order.append(2)
    expect(order, [1, 2])
  }
}

function paren_and(a) {
  return (a > 1) and (a < 5)
}

function paren_mult(a) {
  return (a + 1) * 2
}

function paren_tuple() {
  return (1, 2)
}

@test.TestClass
class LanguageFixesTest {
  @test.Test
  method test_const() {
    const c = 5
    expect(c, 5)
    test.expect_raises(() {
      c = 6
    }, error.Error)
    expect(c, 5)
  }

  @test.Test
  method test_const_in_nested_scope() {
    f = () {
      const k = 1
      k = 2
    }
    test.expect_raises(f, error.Error)
  }

  @test.Test
  method test_const_increment() {
    const n = 1
    test.expect_raises(() {
      n = n + 1
    }, error.Error)
    expect(n, 1)
  }

  @test.Test
  method test_length_expression() {
    a = [1, 2, 3]
    expect(|a|, 3)
    expect(|'hello'|, 5)
    expect(|(1, 2)|, 2)
    expect(|a| + 1, 4)
    expect(3 | 4, 7)
  }

  @test.Test
  method test_return_starting_with_parens() {
    expect(paren_and(3), True)
    expect(paren_and(7), False)
    expect(paren_mult(3), 8)
    expect(paren_tuple(), (1, 2))
  }

  @test.Test
  method test_is_binds_tighter_than_or() {
    a = [1]
    expect(a is Array or a is Tuple, True)
    expect(a is Tuple or a is Array, True)
    expect(a is Tuple and a is Array, False)
    expect(a is Array == True, True)
  }

  @test.Test
  method test_arithmetic_errors_are_catchable() {
    test.expect_raises(() -> True + 1, error.Error)
    test.expect_raises(() -> 1.5 & 1, error.Error)
    test.expect_raises(() -> 1 / 0, error.Error)
    test.expect_raises(() -> 5 % 0, error.Error)
  }

  @test.Test
  method test_float_modulo() {
    expect(7.5 % 2, 1.5)
    expect(-7 % 3, -1)
    expect(1.0 / 4, 0.25)
  }

  @test.Test
  method test_empty_methods_and_functions_exist() {
    expect(EmptyMethods().a(), None)
    expect(EmptyMethods().b(), None)
    expect(empty_fn1(), None)
    expect(empty_fn2(), None)
    expect(EmptyMethods.methods().len(), 2)
  }

  @test.Test
  method test_annotation_on_empty_method() {
    expect(Annotated.methods()[0].annotations[0].value, 7)
  }
}

class EmptyMethods {
  method a() {}
  method b() {}
}

function empty_fn1() {}
function empty_fn2() {}

class Tag {
  new(field value) {}
  method annotate(_) {}
}

class Annotated {
  @Tag(7)
  method m() {}
}
