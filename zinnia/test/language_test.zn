import classes as class_lib
import error
import test

self.expect = test.expect

test.Tester().test(self)

class Defaults {
  new(field a = 1, field b = 2) {}
}

function defaults(p = 10, q = 20, r = 30) {
  return (p, q, r)
}

; Generates class GeneratedBase in the annotated class's module.
class GenerateBase {
  method annotate(cls) {
    builder = class_lib.factory.create_class('GeneratedBase', cls.module())
    builder.add_method('base_value').with_statement('return 42')
    builder.build()
  }
}

@GenerateBase
class Generator {}

; Extends a class that only exists after annotations have run.
class ExtendsGenerated : GeneratedBase {}

@test.TestClass
class DefaultArgumentsTest {
  @test.Test
  method test_constructor_defaults() {
    d = Defaults()
    expect(d.a, 1)
    expect(d.b, 2)
  }

  @test.Test
  method test_constructor_partial_defaults() {
    d = Defaults(5)
    expect(d.a, 5)
    expect(d.b, 2)
  }

  @test.Test
  method test_function_defaults() {
    expect(defaults(), (10, 20, 30))
    expect(defaults(1), (1, 20, 30))
    expect(defaults(1, 2), (1, 2, 30))
    expect(defaults(1, 2, 3), (1, 2, 3))
  }
}

@test.TestClass
class ExpectTest {
  @test.Test
  method test_expect_not() {
    test.expect_not(1, 2)
    test.expect_raises(() -> test.expect_not(1, 1), test.ExpectError)
  }
}

@test.TestClass
class GeneratedSuperclassTest {
  @test.Test
  method test_extends_generated_class() {
    expect(ExtendsGenerated().base_value(), 42)
  }
}

@test.TestClass
class EqualityTest {
  @test.Test
  method test_none_variables() {
    a = None
    b = None
    expect(a == b, True)
    expect(a != b, False)
    expect(None == a, True)
    expect(a == None, True)
    expect(None != a, False)
  }

  @test.Test
  method test_none_and_primitive() {
    n = None
    one = 1
    expect(n == one, False)
    expect(one == n, False)
    expect(n == 1, False)
    expect(n != 1, True)
    expect(1 == n, False)
    expect(1 != n, True)
  }

  @test.Test
  method test_none_and_object() {
    n = None
    s = 'a'
    expect(n == s, False)
    expect(s == n, False)
    expect(n != s, True)
  }

  @test.Test
  method test_primitive_and_object() {
    one = 1
    s = 'a'
    expect(s == 1, False)
    expect(1 == s, False)
    expect(one == s, False)
    expect(s != 1, True)
    expect(1 != s, True)
  }

  @test.Test
  method test_primitives() {
    one = 1
    other_one = 1
    two = 2
    expect(one == other_one, True)
    expect(one == two, False)
    expect(one != two, True)
    expect(one == 1.0, True)
  }

  @test.Test
  method test_expect_none() {
    expect(None, None)
  }
}

@test.TestClass
class ErrorPropagationTest {
  @test.Test
  method test_closure_error_caught_by_caller() {
    caught = None
    try {
      (() { raise error.Error('closure') })()
    } catch e {
      caught = e.message
    }
    expect(caught, 'closure')
  }

  @test.Test
  method test_callback_error_caught_by_caller() {
    caught = None
    try {
      [1, 2].map((i) { raise error.Error('callback ' + str(i)) })
    } catch e {
      caught = e.message
    }
    expect(caught, 'callback 1')
  }

  @test.Test
  method test_error_caught_inside_closure() {
    r = (() {
      try {
        raise error.Error('inside')
      } catch e {
        return 'handled ' + e.message
      }
    })()
    expect(r, 'handled inside')
  }

  @test.Test
  method test_execution_continues_in_order() {
    order = []
    try {
      (() { raise error.Error('x') })()
    } catch e {
      order.append(1)
    }
    order.append(2)
    expect(order, [1, 2])
  }
}

function paren_and(a) {
  return (a > 1) and (a < 5)
}

function paren_mult(a) {
  return (a + 1) * 2
}

function paren_tuple() {
  return (1, 2)
}

@test.TestClass
class LanguageFixesTest {
  @test.Test
  method test_const() {
    const c = 5
    expect(c, 5)
    test.expect_raises(() {
      c = 6
    }, error.Error)
    expect(c, 5)
  }

  @test.Test
  method test_const_in_nested_scope() {
    f = () {
      const k = 1
      k = 2
    }
    test.expect_raises(f, error.Error)
  }

  @test.Test
  method test_const_increment() {
    const n = 1
    test.expect_raises(() {
      n = n + 1
    }, error.Error)
    expect(n, 1)
  }

  @test.Test
  method test_length_expression() {
    a = [1, 2, 3]
    expect(|a|, 3)
    expect(|'hello'|, 5)
    expect(|(1, 2)|, 2)
    expect(|a| + 1, 4)
    expect(3 | 4, 7)
  }

  @test.Test
  method test_return_starting_with_parens() {
    expect(paren_and(3), True)
    expect(paren_and(7), False)
    expect(paren_mult(3), 8)
    expect(paren_tuple(), (1, 2))
  }

  @test.Test
  method test_is_binds_tighter_than_or() {
    a = [1]
    expect(a is Array or a is Tuple, True)
    expect(a is Tuple or a is Array, True)
    expect(a is Tuple and a is Array, False)
    expect(a is Array == True, True)
  }

  @test.Test
  method test_arithmetic_errors_are_catchable() {
    test.expect_raises(() -> True + 1, error.Error)
    test.expect_raises(() -> 1.5 & 1, error.Error)
    test.expect_raises(() -> 1 / 0, error.Error)
    test.expect_raises(() -> 5 % 0, error.Error)
  }

  @test.Test
  method test_float_modulo() {
    expect(7.5 % 2, 1.5)
    expect(-7 % 3, -1)
    expect(1.0 / 4, 0.25)
  }

  @test.Test
  method test_empty_methods_and_functions_exist() {
    expect(EmptyMethods().a(), None)
    expect(EmptyMethods().b(), None)
    expect(empty_fn1(), None)
    expect(empty_fn2(), None)
    expect(EmptyMethods.methods().len(), 2)
  }

  @test.Test
  method test_annotation_on_empty_method() {
    expect(Annotated.methods()[0].annotations[0].value, 7)
  }
}

class EmptyMethods {
  method a() {}
  method b() {}
}

function empty_fn1() {}
function empty_fn2() {}

class Tag {
  new(field value) {}
  method annotate(_) {}
}

class Annotated {
  @Tag(7)
  method m() {}
}

; Declarations say what exists at runtime without code here; they compile to
; nothing.
declare function declared_fn(a, b)
declare function typed_fn(a) returns DeclaredClass

declare class DeclaredClass {
  field f, typed is String
  new(field g)
  method m(x)
  method typed_m() async returns DeclaredClass
}

class PartlyDeclared {
  declare field native_field
  declare field typed_field is DeclaredClass
  declare method native_method(x)
  declare method typed_method() returns DeclaredClass
  declare shorthand(y)
  declare typed_shorthand() returns DeclaredClass
  method real() 'real'
}

@test.TestClass
class DeclareTest {
  @test.Test
  method test_declarations_compile_to_nothing() {
    module = PartlyDeclared.module()
    expect(module.functions().where(f -> f.name() == 'declared_fn').len(), 0)
    expect(module.functions().where(f -> f.name() == 'typed_fn').len(), 0)
    expect(module.classes().where(c -> c.name() == 'DeclaredClass').len(), 0)
    expect(PartlyDeclared().real(), 'real')
    expect(PartlyDeclared.methods().len(), 1)
  }
}

function _depth(n) {
  return if n == 0 then 0 else 1 + _depth(n - 1)
}

function _raise_at(n) {
  if n == 0 {
    raise error.Error('bottom')
  }
  return _raise_at(n - 1)
}

function _first_match(items, x) {
  for (_, item) in items {
    if item == x {
      try {
        return cat('found ', item)
      } catch e {}
    }
  }
  return 'none'
}

function _leaves_values(a, b) a

class _Indexed {
  new(field base) {}
  method [](i) base + i
  method []=(i, v) { base = i + v }
  method ==(other) base == other.base
}

@test.TestClass
class CallTest {
  @test.Test
  method test_deep_recursion() {
    expect(_depth(20000), 20000)
  }

  @test.Test
  method test_errors_unwind_through_calls() {
    message = None
    trace = None
    try {
      _raise_at(3)
    } catch e {
      message = e.message
      trace = e.stacktrace.len()
    }
    expect(message, 'bottom')
    ; _raise_at four times, this method and its callers.
    expect(trace > 4, True)
  }

  @test.Test
  method test_return_from_inside_try_and_loop() {
    expect(_first_match([1, 2, 3], 2), 'found 2')
    expect(_first_match([1, 2, 3], 9), 'none')
  }

  @test.Test
  method test_calls_leave_the_stack_as_it_was() {
    expect([_leaves_values(1, 2), _leaves_values(3, 4), _leaves_values(5, 6)], [1, 3, 5])
  }

  @test.Test
  method test_operator_methods() {
    x = _Indexed(1)
    expect(x[10], 11)
    x[2] = 5
    expect(x.base, 7)
    expect(x == _Indexed(7), True)
    expect(x == _Indexed(8), False)
  }

  @test.Test
  method test_closures_called_in_a_loop() {
    add = (a, b) -> a + b
    total = 0
    for (_, i) in 0:1000 {
      total = add(total, i)
    }
    expect(total, 499500)
  }
}

function _plus_one(x) x + 1

class _Dispatch {
  field stored_fn, stored_lambda
  new(field base) {
    stored_fn = _plus_one
    offset = 100
    stored_lambda = x -> x + offset
  }
  method add(x) base + x
  method twice(x) add(add(x))
}

class _SubDispatch : _Dispatch {
  new(base) {
    super(_Dispatch)(base)
  }
  method add(x) base * x
}

@test.TestClass
class MethodCallTest {
  @test.Test
  method test_methods() {
    d = _Dispatch(10)
    expect(d.add(1), 11)
    expect(d.twice(1), 21)
  }

  @test.Test
  method test_overridden_methods() {
    s = _SubDispatch(10)
    expect(s.add(2), 20)
    expect(s.twice(2), 200)
  }

  @test.Test
  method test_functions_and_lambdas_in_fields() {
    d = _Dispatch(0)
    expect(d.stored_fn(1), 2)
    expect(d.stored_lambda(1), 101)
  }

  @test.Test
  method test_native_methods() {
    expect([1, 2, 3].len(), 3)
    expect('a,b'.split(','), ['a', 'b'])
  }

  @test.Test
  method test_missing_methods_raise() {
    message = None
    try {
      _Dispatch(0).missing()
    } catch e {
      message = e.message
    }
    expect(message, 'Failed to find method \'missing\' on _Dispatch')
  }
}

class _Counted {
  field items, count
  new() {
    items = []
    count = 0
  }
  method add(v) {
    count = count + 1
    items.append(v)
    return count
  }
  method shadow() {
    ; Creates a local, so later reads see it rather than the field.
    local = 5
    $set('local', 99)
    return local
  }
}

function _member_fn() 1

function _replace_member() {
  ; The module's member, since a function's self is its module.
  _member_fn = 'replaced'
}

function _make_counter() {
  c = 0
  return () {
    c = c + 1
    return c
  }
}

function _assign_outer() {
  x = 1
  set_x = v -> x = v
  set_x(7)
  return x
}

function _recurse(n) {
  local = n
  if n > 0 {
    _recurse(n - 1)
  }
  return local
}

function _const_reassign() {
  const k = 1
  k = 2
}

@test.TestClass
class ScopeTest {
  @test.Test
  method test_fields_assigned_without_self() {
    c = _Counted()
    expect(c.add('a'), 1)
    expect(c.add('b'), 2)
    expect(c.count, 2)
    expect(c.items, ['a', 'b'])
  }

  @test.Test
  method test_locals_win_over_later_members() {
    expect(_Counted().shadow(), 5)
  }

  @test.Test
  method test_loop_variables_are_function_wide() {
    for (_, i) in [1, 2, 3] {
      last = i
    }
    expect(i, 3)
    expect(last, 3)
    for j = 0, j < 4, j = j + 1 {}
    expect(j, 4)
  }

  @test.Test
  method test_try_variables_are_function_wide() {
    try {
      inside = 1
      raise error.Error('x')
    } catch e {
      caught = e.message
    }
    expect(inside, 1)
    expect(caught, 'x')
    expect(e.message, 'x')
  }

  @test.Test
  method test_reassigned_in_a_loop() {
    total = 0
    for (_, v) in [1, 2, 3] {
      total = total + v
    }
    expect(total, 6)
  }

  @test.Test
  method test_error_from_a_loop_caught_outside() {
    seen = []
    try {
      for (_, v) in [1, 2, 3] {
        seen.append(v)
        if v == 2 {
          raise error.Error('stop')
        }
      }
    } catch e {}
    expect(seen, [1, 2])
    expect(v, 2)
  }

  @test.Test
  method test_closures_share_captured_variables() {
    counter = _make_counter()
    counter()
    expect(counter(), 2)
    expect(_assign_outer(), 7)
  }

  @test.Test
  method test_functions_assign_module_members() {
    expect(_member_fn(), 1)
    _replace_member()
    expect(_member_fn, 'replaced')
  }

  @test.Test
  method test_recursion_keeps_each_call_variables() {
    expect(_recurse(5), 5)
  }

  @test.Test
  method test_const_reassignment_raises() {
    message = None
    try {
      _const_reassign()
    } catch e {
      message = e.message
    }
    expect(message, 'Cannot reassign const \'k\'.')
  }

  @test.Test
  method test_names_before_assignment_fall_through() {
    ; `str` is read from builtin until this function assigns its own.
    before = str(1)
    str = 'local'
    expect(before, '1')
    expect(str, 'local')
  }
}

function _pair(a, b) (a, b)
function _triple(a, b, c) (a, b, c)
function _with_default(a, b, c=3) (a, b, c)
function _one(x) x
function _named({a, b=2}) (a, b)
function _sum_to(n, acc) {
  return if n == 0 then acc else _sum_to(n - 1, acc + n)
}
function _pair_later(a, b) async {
  return (a, b)
}

class _Point {
  field label
  new(field x, field y) {
    label = cat(x, ',', y)
  }
  method moved(dx, dy) _Point(x + dx, y + dy)
}

class _NoConstructor {}

@test.TestClass
class ArgumentTest {
  @test.Test
  method test_positional_arguments() {
    expect(_pair(1, 2), (1, 2))
    expect(_triple(1, 2, 3), (1, 2, 3))
    expect(_sum_to(100, 0), 5050)
  }

  @test.Test
  method test_a_tuple_fills_the_parameters() {
    expect(_pair((1, 2)), (1, 2))
    args = (4, 5)
    expect(_pair(args), (4, 5))
  }

  @test.Test
  method test_fewer_and_more_arguments() {
    ; A parameter after the first, missing and without a default, is an error.
    raised = False
    try {
      _triple(1, 2)
    } catch e {
      raised = True
    }
    expect(raised, True)
    expect(_with_default(1, 2), (1, 2, 3))
    expect(_with_default(1, 2, 9), (1, 2, 9))
    expect(_pair(1, 2, 3), (1, 2))
    expect(_pair(1), (1, None))
  }

  @test.Test
  method test_one_parameter_gets_a_tuple() {
    expect(_one(1, 2), (1, 2))
    expect(_one(7), 7)
  }

  @test.Test
  method test_named_parameters() {
    expect(_named(a: 1), (1, 2))
    expect(_named(b: 5, a: 4), (4, 5))
  }

  @test.Test
  method test_constructors_and_methods() {
    p = _Point(1, 2)
    expect((p.x, p.y, p.label), (1, 2, '1,2'))
    q = p.moved(10, 20)
    expect((q.x, q.y), (11, 22))
    expect(_NoConstructor(1, 2) is _NoConstructor, True)
  }

  @test.Test
  method test_lambdas_natives_and_async() {
    add = (a, b) -> a + b
    expect(add(2, 3), 5)
    expect(cat('a', 1, 'b'), 'a1b')
    expect(await _pair_later(1, 2), (1, 2))
  }

  @test.Test
  method test_calling_a_non_function_leaves_the_stack_clean() {
    f = None
    message = None
    try {
      f(1, 2)
    } catch e {
      message = e.message
    }
    expect(message != None, True)
    expect([_pair(1, 2), _pair(3, 4)], [(1, 2), (3, 4)])
  }
}

class CacheA {
  method name() 'a'
}

class CacheB {
  method name() 'b'
}

class CacheC : CacheB {}

class CacheD : CacheA {
  method name() 'd'
}

@test.TestClass
class MethodCacheTest {
  @test.Test
  method test_one_call_site_sees_several_classes() {
    ; A call remembers the method it found, so the same call on an object of
    ; another class must still find that class's method.
    names = []
    for (_, o) in [CacheA(), CacheB(), CacheA(), CacheC(), CacheD(), CacheA()] {
      names.append(o.name())
    }
    expect(names, ['a', 'b', 'a', 'b', 'd', 'a'])
  }

  @test.Test
  method test_subclass_after_superclass() {
    names = []
    for (_, o) in [CacheA(), CacheD(), CacheB(), CacheC()] names.append(o.name())
    expect(names, ['a', 'd', 'b', 'b'])
  }
}

function _fused_one(x) x + 1
function _fused_two(a, b) a - b

@test.TestClass
class FusedInstructionTest {
  ; The VM runs some pairs of instructions as one: a comparison and the branch
  ; on it, an instruction and the jump after it, and the moves of a function's
  ; arguments into its parameters. These check that each still behaves as the
  ; two instructions would.

  @test.Test
  method test_comparisons_and_branches() {
    hits = []
    i = 0
    while i < 6 {
      if i == 2 hits.append('eq')
      if i != 3 hits.append(i)
      if (i > 3) and (i <= 4) hits.append('gt')
      if (i < 1) or (i >= 5) hits.append('or')
      i = i + 1
    }
    expect(hits, [0, 'or', 1, 'eq', 2, 4, 'gt', 5, 'or'])
  }

  @test.Test
  method test_comparison_that_raises() {
    ; The comparison raises, so the branch fused to it must not run.
    caught = None
    reached = False
    try {
      if None < 1 reached = True
    } catch e {
      caught = e
    }
    expect(caught != None, True)
    expect(reached, False)
  }

  @test.Test
  method test_if_expressions_and_loops() {
    n = 27
    steps = 0
    while n != 1 {
      n = if n % 2 == 0 then n / 2 else 3 * n + 1
      steps = steps + 1
    }
    expect(steps, 111)
    total = 0
    for (_, j) in 0:10 total = total + (if j > 4 then j else 0)
    expect(total, 35)
  }

  @test.Test
  method test_arguments_into_parameters() {
    expect(_fused_one(1), 2)
    expect(_fused_two(5, 3), 2)
    ; A tuple fills the parameters without the arguments on the stack.
    expect(_fused_two((7, 2)), 5)
    raised = False
    try {
      _fused_two(1)
    } catch e {
      raised = True
    }
    expect(raised, True)
  }
}

; Used by ModuleNameTest. Its functions look names up in the module itself,
; which the VM remembers where it found them.
function _lookup_helper(x) x + 1

function _lookup_shadowed() {
  results = []
  for (_, i) in 0:3 {
    results.append(_lookup_helper(i))
    ; Assigns the module's _lookup_helper, since that's where the name is.
    _lookup_helper = (x) { x * 100 }
    g = () { _lookup_helper(5) }
    results.append(g())
  }
  results
}

function _lookup_sum() {
  t = 0
  for (_, i) in 0:5 t = t + _lookup_helper(i)
  t
}

; Its parameter has the name of a module function. A lambda captures it, so
; it's a named variable, which a lookup must find before the module's.
function _lookup_param(_lookup_helper) {
  g = () { _lookup_helper }
  _lookup_helper
}

@test.TestClass
class ModuleNameTest {
  @test.Test
  method test_a_remembered_name_sees_its_new_value() {
    expect(_lookup_sum(), 15)
    expect(_lookup_shadowed(), [1, 500, 100, 500, 200, 500])
    ; The same lookups again, now that _lookup_helper was reassigned.
    expect(_lookup_sum(), 1000)
    expect(_lookup_shadowed(), [0, 500, 100, 500, 200, 500])
  }

  @test.Test
  method test_a_variable_hides_a_module_name() {
    expect(_lookup_param(7), 7)
    expect(_lookup_param('x'), 'x')
  }
}
