import io
import async

class Test {
  field a, b, c
  new() {
    a = [1, 2, 3, 4, 5]
    b = 12
    c = (a, b)
  }
  method to_s() {
    str('Spawned isolate ', a, b, c)
  }
}

; Test object is copied to the new isolate.
isolate = async.spawn_isolate(
    fn: (t) {
      io.println(t)
      return t
    },
    args: Test())

f = isolate.start()

io.println('Original isolate.')

await f